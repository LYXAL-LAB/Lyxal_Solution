{
  "name": "Lyxal Enterprise",
  "version": "1.0.0",
  "description": "Configuration enterprise complète avec toutes les fonctionnalités",
  "target": "large_business",
  "modules": {
    "base": {
      "enabled": true,
      "submodules": {
        "geographic": {
          "enabled": true,
          "entities": {
            "continent": true,
            "country": true,
            "region": true,
            "subregion": true
          }
        },
        "currency": {
          "enabled": true
        },
        "organisation": {
          "enabled": true
        },
        "planning": {
          "enabled": true
        }
      }
    },
    "crm": {
      "enabled": true,
      "submodules": {
        "lead_management": true,
        "opportunity": true,
        "customer_service": true,
        "marketing_automation": true,
        "customer_portal": true
      }
    },
    "accounting": {
      "enabled": true,
      "submodules": {
        "general_ledger": true,
        "invoicing": true,
        "payment": true,
        "tax_management": true,
        "budget": true,
        "cash_management": true,
        "bank_payment": true
      }
    },
    "production": {
      "enabled": true,
      "submodules": {
        "manufacturing": true,
        "quality": true,
        "maintenance": true,
        "business_production": true
      }
    },
    "human_resource": {
      "enabled": true,
      "submodules": {
        "employee_management": true,
        "timesheet": true,
        "expense": true,
        "leave_management": true,
        "talent": true,
        "recruitment": true
      }
    },
    "project": {
      "enabled": true,
      "submodules": {
        "project_management": true,
        "business_project": true,
        "intervention": true
      }
    },
    "purchase": {
      "enabled": true,
      "submodules": {
        "purchase_management": true,
        "supplier_management": true,
        "supplier_portal": true
      }
    },
    "sale": {
      "enabled": true,
      "submodules": {
        "sale_management": true,
        "supplychain": true
      }
    },
    "stock": {
      "enabled": true
    },
    "fleet": {
      "enabled": true
    },
    "helpdesk": {
      "enabled": true
    },
    "contract": {
      "enabled": true
    },
    "gdpr": {
      "enabled": true
    },
    "mobile_settings": {
      "enabled": true
    }
  },
  "database": {
    "namespace": "lyxal_enterprise",
    "database": "main",
    "url": "ws://127.0.0.1:8000",
    "clustering": {
      "enabled": true,
      "nodes": 3,
      "replication": "full"
    }
  },
  "options": {
    "force_reinstall": false,
    "skip_validation": false,
    "enable_demo_data": false,
    "enable_audit_log": true,
    "enable_performance_monitoring": true
  },
  "features": {
    "multi_tenant": true,
    "api_access": "enterprise",
    "storage_limit": "unlimited",
    "user_limit": "unlimited",
    "custom_branding": true,
    "white_label": true
  },
  "integrations": {
    "email": {
      "enabled": true,
      "provider": "exchange",
      "advanced_routing": true
    },
    "calendar": {
      "enabled": true,
      "provider": "exchange",
      "sync_bidirectional": true
    },
    "reporting": {
      "enabled": true,
      "formats": ["pdf", "excel", "csv", "xml", "json"],
      "scheduled_reports": true,
      "dashboard": true
    },
    "business_intelligence": {
      "enabled": true,
      "provider": "embedded",
      "real_time": true
    },
    "document_management": {
      "enabled": true,
      "versioning": true,
      "workflow": true
    },
    "workflow_engine": {
      "enabled": true,
      "custom_workflows": true,
      "approval_chains": true
    }
  },
  "security": {
    "authentication": {
      "method": "saml",
      "two_factor": true,
      "biometric": true
    },
    "encryption": {
      "database": true,
      "files": true,
      "communications": true
    },
    "backup": {
      "enabled": true,
      "frequency": "real_time",
      "retention": "7_years",
      "geo_redundancy": true
    },
    "compliance": {
      "gdpr": true,
      "hipaa": true,
      "sox": true,
      "iso27001": true
    }
  },
  "performance": {
    "caching": {
      "enabled": true,
      "levels": ["memory", "disk", "distributed"]
    },
    "load_balancing": {
      "enabled": true,
      "algorithm": "least_connections"
    },
    "monitoring": {
      "enabled": true,
      "real_time_alerts": true,
      "predictive": true
    }
  },
  "metadata": {
    "created_at": "2025-01-18T00:00:00Z",
    "created_by": "Lyxal Team",
    "use_cases": [
      "Grande entreprise",
      "Multinational",
      "Haute disponibilité",
      "Conformité réglementaire",
      "Intégrations complexes",
      "Performance critique"
    ]
  }
} 