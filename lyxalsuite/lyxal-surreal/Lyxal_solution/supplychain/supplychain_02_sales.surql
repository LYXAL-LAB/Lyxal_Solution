-- ================================================
-- MODULE AXELOR SUPPLYCHAIN - VENTES AVANCÉES
-- ================================================

-- Table sale_order (étendue pour supplychain)
DEFINE TABLE sale_order SCHEMAFULL;
DEFINE FIELD id ON sale_order TYPE record<sale_order>;
DEFINE FIELD sale_order_seq ON sale_order TYPE string;
DEFINE FIELD company ON sale_order TYPE string;
DEFINE FIELD trading_name ON sale_order TYPE string;
DEFINE FIELD client_partner ON sale_order TYPE string;
DEFINE FIELD contact_partner ON sale_order TYPE string;
DEFINE FIELD main_invoicing_address ON sale_order TYPE string;
DEFINE FIELD delivery_address ON sale_order TYPE string;
DEFINE FIELD order_date ON sale_order TYPE date;
DEFINE FIELD creation_date ON sale_order TYPE datetime;
DEFINE FIELD confirmation_date ON sale_order TYPE datetime;
DEFINE FIELD delivery_date ON sale_order TYPE date;
DEFINE FIELD status_select ON sale_order TYPE int DEFAULT 1;
DEFINE FIELD version_number ON sale_order TYPE int DEFAULT 1;
DEFINE FIELD external_reference ON sale_order TYPE string;
DEFINE FIELD internal_reference ON sale_order TYPE string;
DEFINE FIELD priceList ON sale_order TYPE string;
DEFINE FIELD currency ON sale_order TYPE string;
DEFINE FIELD ex_tax_total ON sale_order TYPE float;
DEFINE FIELD tax_total ON sale_order TYPE float;
DEFINE FIELD in_tax_total ON sale_order TYPE float;
DEFINE FIELD advance_total ON sale_order TYPE float;
DEFINE FIELD opportunity ON sale_order TYPE string;
DEFINE FIELD source ON sale_order TYPE string;
DEFINE FIELD description ON sale_order TYPE string;
DEFINE FIELD note ON sale_order TYPE string;
DEFINE FIELD stock_location ON sale_order TYPE string;
DEFINE FIELD shipment_mode ON sale_order TYPE string;
DEFINE FIELD freight_carrier_mode ON sale_order TYPE string;
DEFINE FIELD interco ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD created_by_interco ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD delivery_state ON sale_order TYPE int DEFAULT 1;
DEFINE FIELD invoicing_state ON sale_order TYPE int DEFAULT 1;
DEFINE FIELD advance_payment_needed ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD advance_payment_state ON sale_order TYPE int DEFAULT 1;
DEFINE FIELD blocked_on_cust_credit_exceed ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD manual_unblock ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD template ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD duration ON sale_order TYPE int;
DEFINE FIELD end_of_validity_date ON sale_order TYPE date;
DEFINE FIELD created_on ON sale_order TYPE datetime DEFAULT time::now();
DEFINE FIELD updated_on ON sale_order TYPE datetime DEFAULT time::now();

-- Table sale_order_line (lignes de commande)
DEFINE TABLE sale_order_line SCHEMAFULL;
DEFINE FIELD id ON sale_order_line TYPE record<sale_order_line>;
DEFINE FIELD sale_order ON sale_order_line TYPE string;
DEFINE FIELD sequence ON sale_order_line TYPE int;
DEFINE FIELD product ON sale_order_line TYPE string;
DEFINE FIELD product_name ON sale_order_line TYPE string;
DEFINE FIELD product_code ON sale_order_line TYPE string;
DEFINE FIELD qty ON sale_order_line TYPE float;
DEFINE FIELD unit ON sale_order_line TYPE string;
DEFINE FIELD price ON sale_order_line TYPE float;
DEFINE FIELD price_discounted ON sale_order_line TYPE float;
DEFINE FIELD discount_amount ON sale_order_line TYPE float;
DEFINE FIELD discount_type_select ON sale_order_line TYPE int;
DEFINE FIELD ex_tax_total ON sale_order_line TYPE float;
DEFINE FIELD in_tax_total ON sale_order_line TYPE float;
DEFINE FIELD tax_line ON sale_order_line TYPE string;
DEFINE FIELD description ON sale_order_line TYPE string;
DEFINE FIELD is_title_line ON sale_order_line TYPE bool DEFAULT false;
DEFINE FIELD type_select ON sale_order_line TYPE int DEFAULT 1;
DEFINE FIELD delivery_state ON sale_order_line TYPE int DEFAULT 1;
DEFINE FIELD invoicing_state ON sale_order_line TYPE int DEFAULT 1;
DEFINE FIELD delivered_qty ON sale_order_line TYPE float;
DEFINE FIELD invoiced_qty ON sale_order_line TYPE float;
DEFINE FIELD reserved_qty ON sale_order_line TYPE float;
DEFINE FIELD requested_reserved_qty ON sale_order_line TYPE float;
DEFINE FIELD allocated_qty ON sale_order_line TYPE float;
DEFINE FIELD desired_delivery_date ON sale_order_line TYPE date;
DEFINE FIELD estimated_delivery_date ON sale_order_line TYPE date;
DEFINE FIELD complementary_product_list ON sale_order_line TYPE string;
DEFINE FIELD selected_complementary_product_list ON sale_order_line TYPE string;
DEFINE FIELD supplier_partner ON sale_order_line TYPE string;
DEFINE FIELD purchase_order ON sale_order_line TYPE string;
DEFINE FIELD purchase_order_line ON sale_order_line TYPE string;
DEFINE FIELD analytic_move_line_list ON sale_order_line TYPE string;
DEFINE FIELD budget_distribution_sum_amount ON sale_order_line TYPE float;
DEFINE FIELD created_on ON sale_order_line TYPE datetime DEFAULT time::now();
DEFINE FIELD updated_on ON sale_order_line TYPE datetime DEFAULT time::now();

-- Table timetable (échéanciers)
DEFINE TABLE timetable SCHEMAFULL;
DEFINE FIELD id ON timetable TYPE record<timetable>;
DEFINE FIELD name ON timetable TYPE string;
DEFINE FIELD sale_order ON timetable TYPE string;
DEFINE FIELD estimated_date ON timetable TYPE date;
DEFINE FIELD amount ON timetable TYPE float;
DEFINE FIELD percentage ON timetable TYPE float;
DEFINE FIELD invoice_id ON timetable TYPE string;
DEFINE FIELD invoiced ON timetable TYPE bool DEFAULT false;
DEFINE FIELD created_on ON timetable TYPE datetime DEFAULT time::now();
DEFINE FIELD updated_on ON timetable TYPE datetime DEFAULT time::now();

-- Table advance_payment (acomptes)
DEFINE TABLE advance_payment SCHEMAFULL;
DEFINE FIELD id ON advance_payment TYPE record<advance_payment>;
DEFINE FIELD advance_payment_seq ON advance_payment TYPE string;
DEFINE FIELD sale_order ON advance_payment TYPE string;
DEFINE FIELD purchase_order ON advance_payment TYPE string;
DEFINE FIELD partner ON advance_payment TYPE string;
DEFINE FIELD company ON advance_payment TYPE string;
DEFINE FIELD currency ON advance_payment TYPE string;
DEFINE FIELD amount ON advance_payment TYPE float;
DEFINE FIELD amount_remaining ON advance_payment TYPE float;
DEFINE FIELD advance_date ON advance_payment TYPE date;
DEFINE FIELD status_select ON advance_payment TYPE int DEFAULT 1;
DEFINE FIELD payment_mode ON advance_payment TYPE string;
DEFINE FIELD payment_condition ON advance_payment TYPE string;
DEFINE FIELD invoice ON advance_payment TYPE string;
DEFINE FIELD move ON advance_payment TYPE string;
DEFINE FIELD imputation_move ON advance_payment TYPE string;
DEFINE FIELD created_on ON advance_payment TYPE datetime DEFAULT time::now();
DEFINE FIELD updated_on ON advance_payment TYPE datetime DEFAULT time::now();

-- Table stock_move (mouvements de stock)
DEFINE TABLE stock_move SCHEMAFULL;
DEFINE FIELD id ON stock_move TYPE record<stock_move>;
DEFINE FIELD stock_move_seq ON stock_move TYPE string;
DEFINE FIELD name ON stock_move TYPE string;
DEFINE FIELD company ON stock_move TYPE string;
DEFINE FIELD partner ON stock_move TYPE string;
DEFINE FIELD from_stock_location ON stock_move TYPE string;
DEFINE FIELD to_stock_location ON stock_move TYPE string;
DEFINE FIELD planned_date ON stock_move TYPE date;
DEFINE FIELD estimated_date ON stock_move TYPE date;
DEFINE FIELD real_date ON stock_move TYPE date;
DEFINE FIELD type_select ON stock_move TYPE int;
DEFINE FIELD status_select ON stock_move TYPE int DEFAULT 1;
DEFINE FIELD conformity_select ON stock_move TYPE int DEFAULT 1;
DEFINE FIELD availability_request ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD picking_is_editable ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD sale_order ON stock_move TYPE string;
DEFINE FIELD purchase_order ON stock_move TYPE string;
DEFINE FIELD invoice ON stock_move TYPE string;
DEFINE FIELD origin_id ON stock_move TYPE string;
DEFINE FIELD origin_type_select ON stock_move TYPE string;
DEFINE FIELD trading_name ON stock_move TYPE string;
DEFINE FIELD note ON stock_move TYPE string;
DEFINE FIELD group_product_on_printing ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD full_spread_over_products ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD reverse_origin_stock_move ON stock_move TYPE string;
DEFINE FIELD created_on ON stock_move TYPE datetime DEFAULT time::now();
DEFINE FIELD updated_on ON stock_move TYPE datetime DEFAULT time::now();

-- Table stock_move_line (lignes de mouvements)
DEFINE TABLE stock_move_line SCHEMAFULL;
DEFINE FIELD id ON stock_move_line TYPE record<stock_move_line>;
DEFINE FIELD stock_move ON stock_move_line TYPE string;
DEFINE FIELD product ON stock_move_line TYPE string;
DEFINE FIELD product_name ON stock_move_line TYPE string;
DEFINE FIELD unit ON stock_move_line TYPE string;
DEFINE FIELD qty ON stock_move_line TYPE float;
DEFINE FIELD real_qty ON stock_move_line TYPE float;
DEFINE FIELD reserved_qty ON stock_move_line TYPE float;
DEFINE FIELD requested_reserved_qty ON stock_move_line TYPE float;
DEFINE FIELD unit_price_untaxed ON stock_move_line TYPE float;
DEFINE FIELD unit_price_taxed ON stock_move_line TYPE float;
DEFINE FIELD conformity_select ON stock_move_line TYPE int DEFAULT 1;
DEFINE FIELD sale_order_line ON stock_move_line TYPE string;
DEFINE FIELD purchase_order_line ON stock_move_line TYPE string;
DEFINE FIELD invoice_line ON stock_move_line TYPE string;
DEFINE FIELD description ON stock_move_line TYPE string;
DEFINE FIELD locker_rack ON stock_move_line TYPE string;
DEFINE FIELD track_number ON stock_move_line TYPE string;
DEFINE FIELD warranty_expiry_date ON stock_move_line TYPE date;
DEFINE FIELD perishable_expiry_date ON stock_move_line TYPE date;
DEFINE FIELD counter ON stock_move_line TYPE int;
DEFINE FIELD created_on ON stock_move_line TYPE datetime DEFAULT time::now();
DEFINE FIELD updated_on ON stock_move_line TYPE datetime DEFAULT time::now();

-- Table stock_location (emplacements)
DEFINE TABLE stock_location SCHEMAFULL;
DEFINE FIELD id ON stock_location TYPE record<stock_location>;
DEFINE FIELD name ON stock_location TYPE string;
DEFINE FIELD parent_stock_location ON stock_location TYPE string;
DEFINE FIELD company ON stock_location TYPE string;
DEFINE FIELD partner ON stock_location TYPE string;
DEFINE FIELD address ON stock_location TYPE string;
DEFINE FIELD type_select ON stock_location TYPE int;
DEFINE FIELD is_default ON stock_location TYPE bool DEFAULT false;
DEFINE FIELD is_valued_stock ON stock_location TYPE bool DEFAULT false;
DEFINE FIELD usage_select ON stock_location TYPE int;
DEFINE FIELD directional_location_select ON stock_location TYPE int;
DEFINE FIELD stock_valuation_type_select ON stock_location TYPE int;
DEFINE FIELD sequence ON stock_location TYPE int;
DEFINE FIELD created_on ON stock_location TYPE datetime DEFAULT time::now();
DEFINE FIELD updated_on ON stock_location TYPE datetime DEFAULT time::now();

-- Table inventory (inventaires)
DEFINE TABLE inventory SCHEMAFULL;
DEFINE FIELD id ON inventory TYPE record<inventory>;
DEFINE FIELD inventory_seq ON inventory TYPE string;
DEFINE FIELD company ON inventory TYPE string;
DEFINE FIELD stock_location ON inventory TYPE string;
DEFINE FIELD planned_start_date_t ON inventory TYPE datetime;
DEFINE FIELD planned_end_date_t ON inventory TYPE datetime;
DEFINE FIELD date_t ON inventory TYPE datetime;
DEFINE FIELD status_select ON inventory TYPE int DEFAULT 1;
DEFINE FIELD type_select ON inventory TYPE int DEFAULT 1;
DEFINE FIELD exclude_out_of_stock ON inventory TYPE bool DEFAULT false;
DEFINE FIELD include_obsolete_product ON inventory TYPE bool DEFAULT false;
DEFINE FIELD description ON inventory TYPE string;
DEFINE FIELD comments ON inventory TYPE string;
DEFINE FIELD created_on ON inventory TYPE datetime DEFAULT time::now();
DEFINE FIELD updated_on ON inventory TYPE datetime DEFAULT time::now(); 