-- â”‚  fn::booking_authenticate_user                                          â”‚
-- â”‚  Recherche un compte utilisateur par son adresse e-mail                 â”‚
-- â””â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”˜

DEFINE FUNCTION OVERWRITE fn::booking_authenticate_user(
    $email: option<string>
) {
    IF $email == NONE OR string::len(string::trim($email)) == 0 {
        THROW "Parameter 'email' is required";
    };

    LET $clean_email = string::lowercase(string::trim($email));
    LET $users = SELECT * FROM booking_account WHERE email = $clean_email LIMIT 1;

    RETURN IF array::len($users) > 0 { $users[0] } ELSE { NONE };
} COMMENT "Recherche un compte utilisateur actif par son adresse e-mail";
