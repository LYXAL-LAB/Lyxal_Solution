DEFINE FUNCTION OVERWRITE fn::booking_get_company_link() {
    LET $res = SELECT VALUE value FROM booking_setting WHERE setting_key = 'company_link' LIMIT 1;
    RETURN IF array::len($res) > 0 { $res[0] } ELSE { NONE };
} COMMENT "RÃ©cupÃ¨re l'URL du site web entreprise depuis les paramÃ¨tres systÃ¨me";
