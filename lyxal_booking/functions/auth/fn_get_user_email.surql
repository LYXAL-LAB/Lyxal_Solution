DEFINE FUNCTION OVERWRITE fn::booking_get_user_email(
    $account_id: option<record<booking_account>>
) {
    IF $account_id == NONE {
        THROW "Parameter 'account_id' is required";
    };

    LET $res = SELECT VALUE email FROM $account_id;
    RETURN IF array::len($res) > 0 { $res[0] } ELSE { NONE };
} COMMENT "RÃ©cupÃ¨re l'adresse e-mail d'un compte utilisateur";
