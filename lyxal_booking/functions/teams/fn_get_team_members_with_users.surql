-- â””â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”˜

DEFINE FUNCTION OVERWRITE fn::booking_get_team_members_with_users(
    $team_id: option<record<booking_team>>
) {
    IF $team_id == NONE {
        THROW "Parameter 'team_id' is required";
    };

    RETURN SELECT 
        in.id AS id,
        in.name AS name,
        in.email AS email,
        in.avatar_url AS avatar_url,
        role,
        weight,
        source
    FROM booking_team_member
    WHERE out = $team_id
    ORDER BY role ASC, in.name ASC;
} COMMENT "RÃ©cupÃ¨re les dÃ©tails des membres d'une Ã©quipe pour les pages de configuration";
