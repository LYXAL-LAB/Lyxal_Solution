DEFINE FUNCTION OVERWRITE fn::booking_get_team_invite_token(
    $team_id: option<record<booking_team>>
) {
    IF $team_id == NONE {
        THROW "Parameter 'team_id' is required";
    };

    LET $res = SELECT VALUE invite_token FROM $team_id;
    RETURN IF array::len($res) > 0 { $res[0] } ELSE { NONE };
} COMMENT "RÃ©cupÃ¨re le jeton d'invitation privÃ©e d'une Ã©quipe";
