DEFINE FUNCTION OVERWRITE fn::booking_clear_team_avatar_path(
    $team_id: option<record<booking_team>>
) {
    IF $team_id == NONE {
        THROW "Parameter 'team_id' is required";
    };

    UPDATE $team_id SET logo_url = NONE, updated_at = time::now();
    RETURN true;
} COMMENT "Supprime le logo/avatar d'une Ã©quipe";
