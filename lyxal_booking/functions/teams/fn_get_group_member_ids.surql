DEFINE FUNCTION OVERWRITE fn::booking_get_group_member_ids(
    $group_id: option<string>
) {
    IF $group_id == NONE OR string::len(string::trim($group_id)) == 0 {
        THROW "Parameter 'group_id' is required";
    };

    LET $clean_gid = string::trim($group_id);
    RETURN SELECT VALUE user_id FROM user_group WHERE group_id = $clean_gid;
} COMMENT "RÃ©cupÃ¨re les identifiants d'utilisateurs membres d'un groupe OIDC spÃ©cifiÃ©";
