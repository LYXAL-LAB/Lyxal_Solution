DEFINE FUNCTION OVERWRITE fn::booking_get_oidc_groups_with_counts() {
    RETURN SELECT 
        id,
        name,
        (SELECT VALUE count() FROM user_group WHERE group_id = $parent.id) AS member_count
    FROM oidc_group
    ORDER BY name ASC;
} COMMENT "RÃ©cupÃ¨re la liste des groupes OIDC et le nombre d'utilisateurs associÃ©s";
