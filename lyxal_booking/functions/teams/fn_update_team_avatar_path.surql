-- â”‚  Met Ã  jour l'URL du logo/avatar d'une Ã©quipe                           â”‚
-- â””â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”˜

DEFINE FUNCTION OVERWRITE fn::booking_update_team_avatar_path(
    $team_id: option<record<booking_team>>,
    $avatar_path: option<string>
) {
    IF $team_id == NONE {
        THROW "Parameter 'team_id' is required";
    };

    LET $clean_logo = IF $avatar_path != NONE {
        string::trim($avatar_path)
    } ELSE {
        NONE
    };
    UPDATE $team_id SET logo_url = $clean_logo, updated_at = time::now();

    RETURN true;
} COMMENT "Met Ã  jour l'URL du logo/avatar d'une Ã©quipe";
