DEFINE FUNCTION OVERWRITE fn::booking_nullify_event_types_team(
    $team_id: option<record<booking_team>>
) {
    IF $team_id == NONE {
        THROW "Parameter 'team_id' is required";
    };

    UPDATE booking_event_type SET team = NONE WHERE team = $team_id;
    RETURN true;
} COMMENT "DÃ©tache une Ã©quipe des types d'Ã©vÃ©nements associÃ©s";
