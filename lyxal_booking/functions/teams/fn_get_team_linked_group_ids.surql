DEFINE FUNCTION OVERWRITE fn::booking_get_team_linked_group_ids(
    $team_id: option<record<booking_team>>
) {
    IF $team_id == NONE {
        THROW "Parameter 'team_id' is required";
    };

    RETURN SELECT VALUE group_id FROM team_group WHERE team_id = $team_id;
} COMMENT "RÃ©cupÃ¨re la liste des IDs de groupes OIDC rattachÃ©s Ã  une Ã©quipe";
