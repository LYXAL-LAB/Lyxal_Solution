DEFINE FUNCTION OVERWRITE fn::booking_get_team_avatar_path(
    $team_id: option<record<booking_team>>
) {
    IF $team_id == NONE {
        THROW "Parameter 'team_id' is required";
    };

    LET $res = SELECT VALUE logo_url FROM $team_id;
    RETURN IF array::len($res) > 0 { $res[0] } ELSE { NONE };
} COMMENT "RÃ©cupÃ¨re l'URL du logo/avatar d'une Ã©quipe";
