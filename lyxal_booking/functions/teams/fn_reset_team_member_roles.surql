DEFINE FUNCTION OVERWRITE fn::booking_reset_team_member_roles(
    $team_id: option<record<booking_team>>
) {
    IF $team_id == NONE {
        THROW "Parameter 'team_id' is required";
    };

    UPDATE booking_team_member SET role = 'member' WHERE out = $team_id;
    RETURN true;
} COMMENT "Passe tous les membres d'une Ã©quipe au rÃ´le par dÃ©faut 'member'";
