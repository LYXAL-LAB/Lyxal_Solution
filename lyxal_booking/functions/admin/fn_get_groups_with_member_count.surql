DEFINE FUNCTION OVERWRITE fn::booking_get_groups_with_member_count() {
    RETURN SELECT 
        id, 
        name, 
        (SELECT VALUE count() FROM user_group WHERE group_id = $parent.id) AS member_count 
    FROM oidc_group 
    ORDER BY name ASC;
} COMMENT "RÃ©cupÃ¨re tous les groupes d'utilisateurs OIDC avec le nombre d'utilisateurs rattachÃ©s";
