DEFINE FUNCTION OVERWRITE fn::booking_mark_reminder_sent(
    $reminder_id: option<record<booking_reminder>>
) {
    IF $reminder_id == NONE {
        THROW "Parameter 'reminder_id' is required";
    };

    UPDATE $reminder_id SET status = 'sent', sent_at = time::now();
    RETURN true;
} COMMENT "Marque un rappel automatisÃ© comme dÃ©livrÃ© dans la table booking_reminder";
