-- â””â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”˜

DEFINE FUNCTION OVERWRITE fn::booking_get_pending_bookings(
    $account_id: option<record<booking_account>>
) {
    IF $account_id == NONE {
        THROW "Parameter 'account_id' is required";
    };

    RETURN SELECT id, 
                  booker_name, 
                  booker_email, 
                  start_at, 
                  end_at, 
                  event_type.title AS title, 
                  booker_timezone 
             FROM booking 
            WHERE host = $account_id 
              AND status = 'pending' 
            ORDER BY start_at ASC;
} COMMENT "RÃ©cupÃ¨re la liste des rÃ©servations en attente d'approbation manuelle pour le tableau de bord";
