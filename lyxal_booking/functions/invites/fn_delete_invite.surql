DEFINE FUNCTION OVERWRITE fn::booking_delete_invite(
    $invite_id: option<string>
) {
    IF $invite_id == NONE OR string::len(string::trim($invite_id)) == 0 {
        THROW "Parameter 'invite_id' is required";
    };

    LET $clean_id = string::trim($invite_id);

    -- Suppression sans mot-clÃ© SQL FROM
    DELETE booking_invite WHERE id = $clean_id OR token = $clean_id;
    RETURN true;
} COMMENT "RÃ©voque un lien d'invitation Ã©phÃ©mÃ¨re";
