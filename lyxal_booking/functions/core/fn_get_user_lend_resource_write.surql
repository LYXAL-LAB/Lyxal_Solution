DEFINE FUNCTION OVERWRITE fn::booking_get_user_lend_resource_write(
    $account_id: option<record<booking_account>>
) {
    IF $account_id == NONE {
        THROW "Parameter 'account_id' is required";
    };

    LET $res = SELECT id, enabled FROM $account_id;
    RETURN IF array::len($res) > 0 { $res[0].enabled } ELSE { false };
} COMMENT "VÃ©rifie les droits de gestion de ressources pour un compte hÃ´te";
