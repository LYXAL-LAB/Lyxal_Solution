DEFINE FUNCTION OVERWRITE fn::booking_get_all_enabled_users() {
    RETURN SELECT id, name, email, avatar_url, role 
             FROM booking_account 
            WHERE enabled = true 
            ORDER BY name ASC;
} COMMENT "RÃ©cupÃ¨re la liste de tous les comptes actifs pour la sÃ©lection de membres";
