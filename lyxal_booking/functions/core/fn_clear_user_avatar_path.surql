-- â”‚  fn::booking_clear_user_avatar_path                                     â”‚
-- â”‚  Supprime l'URL d'avatar d'un compte utilisateur                        â”‚
-- â””â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”˜

DEFINE FUNCTION OVERWRITE fn::booking_clear_user_avatar_path(
    $account_id: option<record<booking_account>>
) {
    IF $account_id == NONE {
        THROW "Parameter 'account_id' is required";
    };

    UPDATE $account_id SET avatar_url = NONE, updated_at = time::now();
    RETURN true;
} COMMENT "Efface la photo de profil/avatar d'un compte utilisateur";
