DEFINE FUNCTION OVERWRITE fn::booking_get_resource_caldav_credentials(
    $resource_id: option<record<booking_resource>>
) {
    IF $resource_id == NONE {
        THROW "Parameter 'resource_id' is required";
    };

    LET $res = SELECT id, name, description, capacity, location, enabled FROM $resource_id;
    RETURN IF array::len($res) > 0 { $res[0] } ELSE { NONE };
} COMMENT "RÃ©cupÃ¨re les dÃ©tails d'une ressource physique spÃ©cifiÃ©e";
