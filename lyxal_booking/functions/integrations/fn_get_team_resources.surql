DEFINE FUNCTION OVERWRITE fn::booking_get_team_resources(
    $team_id: option<record<booking_team>>
) {
    IF $team_id == NONE {
        THROW "Parameter 'team_id' is required";
    };

    RETURN SELECT id, name, description, capacity, location 
             FROM booking_resource 
            WHERE enabled = true 
            ORDER BY name ASC;
} COMMENT "RÃ©cupÃ¨re les ressources physiques actives accessibles Ã  une Ã©quipe";
