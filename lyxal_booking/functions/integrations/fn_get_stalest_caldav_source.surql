DEFINE FUNCTION OVERWRITE fn::booking_get_stalest_caldav_source() {
    LET $res = SELECT id, account, provider, url, username, last_synced 
                 FROM booking_caldav_source 
                ORDER BY last_synced ASC LIMIT 1;
    RETURN IF array::len($res) > 0 { $res[0] } ELSE { NONE };
} COMMENT "SÃ©lectionne la source CalDAV la plus ancienne pour les routines de synchronisation en arriÃ¨re-plan";
