DEFINE FUNCTION OVERWRITE fn::booking_get_user_calendars(
    $account_id: option<record<booking_account>>
) {
    IF $account_id == NONE {
        THROW "Parameter 'account_id' is required";
    };

    RETURN SELECT id, source, calendar_id, display_name, color, ctag, is_busy, is_writable, created_at
             FROM booking_calendar
            WHERE source.account = $account_id
            ORDER BY display_name ASC;
} COMMENT "RÃ©cupÃ¨re les calendriers distants synchronisÃ©s d'un compte hÃ´te";
