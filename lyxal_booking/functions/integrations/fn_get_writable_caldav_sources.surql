-- â””â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”˜

DEFINE FUNCTION OVERWRITE fn::booking_get_writable_caldav_sources(
    $account_id: option<record<booking_account>>
) {
    IF $account_id == NONE {
        THROW "Parameter 'account_id' is required";
    };

    RETURN SELECT id, provider, url, username, password, access_token, refresh_token 
             FROM booking_caldav_source 
            WHERE account = $account_id 
              AND (SELECT VALUE count() FROM booking_calendar WHERE source = $parent.id AND is_writable = true) > 0;
} COMMENT "RÃ©cupÃ¨re les sources de calendrier distantes ayant au moins un calendrier accessible en Ã©criture";
