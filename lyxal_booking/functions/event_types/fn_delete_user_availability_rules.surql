DEFINE FUNCTION OVERWRITE fn::booking_delete_user_availability_rules(
    $schedule_id: option<record<booking_schedule>>
) {
    IF $schedule_id == NONE {
        THROW "Parameter 'schedule_id' is required";
    };

    DELETE booking_schedule_rule WHERE schedule = $schedule_id;
    RETURN true;
} COMMENT "Supprime toutes les rÃ¨gles hebdomadaires rÃ©currentes associÃ©es Ã  un planning rÃ©utilisable";
