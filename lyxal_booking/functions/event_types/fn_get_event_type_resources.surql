DEFINE FUNCTION OVERWRITE fn::booking_get_event_type_resources(
    $event_type_id: option<record<booking_event_type>>
) {
    RETURN SELECT id, name, description, capacity, location, enabled 
             FROM booking_resource 
            WHERE enabled = true 
            ORDER BY name ASC;
} COMMENT "RÃ©cupÃ¨re les ressources physiques sÃ©lectionnables";
