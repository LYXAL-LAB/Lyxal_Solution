DEFINE FUNCTION OVERWRITE fn::booking_count_user_availability_rules(
    $schedule_id: option<record<booking_schedule>>
) {
    IF $schedule_id == NONE {
        THROW "Parameter 'schedule_id' is required";
    };

    LET $cnt = SELECT VALUE count() FROM booking_schedule_rule WHERE schedule = $schedule_id;
    RETURN IF array::len($cnt) > 0 { $cnt[0] } ELSE { 0 };
} COMMENT "Compte le nombre de rÃ¨gles rÃ©currentes configurÃ©es dans un planning rÃ©utilisable";
