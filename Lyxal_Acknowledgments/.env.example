# Application
BASE_URL=http://localhost:3000
ORGANISATION=My Organisation
ADMIN_EMAILS=admin@example.com
ONLY_ADMIN_CAN_CREATE=false

# Database (SurrealDB)
DB_URL=ws://localhost:8000/rpc
DB_NAMESPACE=lyxal
DB_DATABASE=acknowledgments
DB_USERNAME=root
DB_PASSWORD=root

# Server
PORT=3000

# Logging
LOG_LEVEL=info
LOG_FORMAT=classic

# Authentication - OAuth (Optional)
AUTH_OAUTH_ENABLED=false
OAUTH_PROVIDER=google
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ALLOWED_DOMAIN=
OAUTH_AUTO_LOGIN=false
OAUTH_COOKIE_SECRET=

# Authentication - Magic Link (Optional, requires SMTP)
AUTH_MAGICLINK_ENABLED=false

# SMTP (Required for Magic Link and Reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
SMTP_STARTTLS=true
SMTP_TIMEOUT=10s
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=My Organisation
SMTP_SUBJECT_PREFIX=[Acknowledgments]
SMTP_TEMPLATE_DIR=templates/emails
SMTP_DEFAULT_LOCALE=en

# Checksum
CHECKSUM_MAX_BYTES=10485760
CHECKSUM_TIMEOUT_MS=5000
CHECKSUM_MAX_REDIRECTS=3

# Crypto (Ed25519 signing key for documents)
ACKIFY_PRIVATE_KEY=your_base64_private_key_here
