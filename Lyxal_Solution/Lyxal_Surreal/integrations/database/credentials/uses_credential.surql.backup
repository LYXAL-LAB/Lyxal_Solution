-- =====================================================
-- RELATION: uses_credential
-- Relation entre service et credential_type
-- =====================================================
-- 
-- Cette table de relation (edge) lie un service à un ou plusieurs
-- types de credentials qu'il peut utiliser pour s'authentifier.
-- 
-- Un service peut supporter plusieurs types de credentials.
-- Par exemple, Google Sheets peut supporter:
-- - OAuth2 (recommandé)
-- - Service Account (pour automation serveur)
-- 
-- Direction de la relation:
-- service -> uses_credential -> credential_type
-- =====================================================

DEFINE TABLE uses_credential TYPE RELATION SCHEMAFULL;

-- Point de départ de la relation (le service)
-- Exemple: service:google_sheets, service:slack, etc.
DEFINE FIELD in ON uses_credential TYPE record<service>;

-- Point d'arrivée de la relation (le type de credential)
-- Exemple: credential_type:google_sheets_oauth2, etc.
DEFINE FIELD out ON uses_credential TYPE record<credential_type>;

-- Est-ce que ce credential est obligatoire pour utiliser le service ?
-- true = L'utilisateur DOIT configurer ce credential
-- false = Ce credential est optionnel (alternative disponible)
DEFINE FIELD is_required ON uses_credential TYPE bool DEFAULT true;

-- Priorité/ordre d'affichage
-- Plus le nombre est petit, plus il est affiché en premier
-- Utile quand un service supporte plusieurs credentials
DEFINE FIELD display_order ON uses_credential TYPE int DEFAULT 0;

-- Conditions d'affichage dans l'interface
-- Permet d'afficher certains credentials seulement dans certains contextes
-- Structure attendue:
-- {
--   show: {
--     authentication: ["oAuth2"],  // Afficher seulement si auth mode = oAuth2
--     version: ["2.0", "3.0"]      // Afficher seulement pour ces versions
--   },
--   hide: {
--     plan: ["free"]               // Cacher pour le plan gratuit
--   }
-- }
DEFINE FIELD display_conditions ON uses_credential TYPE option<object>;

-- Label personnalisé pour ce credential dans ce service
-- Par défaut, utilise le display_name du credential_type
-- Mais peut être surchargé ici si nécessaire
DEFINE FIELD custom_label ON uses_credential TYPE option<string>;

-- Description personnalisée pour ce credential dans ce service
-- Exemple: "OAuth2 is recommended for most users"
DEFINE FIELD custom_description ON uses_credential TYPE option<string>;

-- Est-ce que ce credential est recommandé pour ce service ?
DEFINE FIELD is_recommended ON uses_credential TYPE bool DEFAULT false;

-- Metadata pour informations supplémentaires
-- Peut contenir:
-- - scopes_required: scopes OAuth2 spécifiques pour ce service
-- - permissions_needed: permissions nécessaires
-- - setup_instructions: instructions spécifiques
DEFINE FIELD metadata ON uses_credential TYPE option<object>;

-- Timestamp de création
DEFINE FIELD created_at ON uses_credential TYPE datetime DEFAULT time::now();

-- =====================================================
-- INDEX
-- =====================================================

-- Index sur le service pour récupérer tous ses credentials
DEFINE INDEX uses_credential_in_idx ON uses_credential FIELDS in;

-- Index sur le credential_type pour savoir quels services l'utilisent
DEFINE INDEX uses_credential_out_idx ON uses_credential FIELDS out;

-- Index composite pour éviter les doublons
DEFINE INDEX uses_credential_unique_idx ON uses_credential FIELDS in, out UNIQUE;

-- Index sur is_required pour filtrer les credentials obligatoires
DEFINE INDEX uses_credential_required_idx ON uses_credential FIELDS is_required;

-- =====================================================
-- EXEMPLES D'INSERTION
-- =====================================================

-- Exemple 1: Google Sheets utilise OAuth2 (recommandé)
/*
RELATE service:google_sheets->uses_credential->credential_type:google_sheets_oauth2 SET
    is_required = true,
    is_recommended = true,
    display_order = 1,
    custom_description = "OAuth2 is the recommended authentication method for Google Sheets",
    metadata = {
        scopes_required: [
            "https://www.googleapis.com/auth/spreadsheets",
            "https://www.googleapis.com/auth/drive.file"
        ]
    };
*/

-- Exemple 2: Google Sheets peut aussi utiliser Service Account
/*
RELATE service:google_sheets->uses_credential->credential_type:google_service_account SET
    is_required = false,
    is_recommended = false,
    display_order = 2,
    custom_label = "Service Account (Advanced)",
    custom_description = "Use a Service Account for server-to-server authentication without user interaction",
    metadata = {
        use_case: "automation",
        scopes_required: [
            "https://www.googleapis.com/auth/spreadsheets"
        ]
    };
*/

-- Exemple 3: Slack utilise OAuth2
/*
RELATE service:slack->uses_credential->credential_type:slack_oauth2 SET
    is_required = true,
    is_recommended = true,
    display_order = 1,
    display_conditions = {
        show: {
            authentication: ["oAuth2"]
        }
    };
*/

-- Exemple 4: Slack peut aussi utiliser un API Token
/*
RELATE service:slack->uses_credential->credential_type:slack_api_token SET
    is_required = false,
    display_order = 2,
    custom_label = "Access Token (Legacy)",
    custom_description = "Use a legacy API token. OAuth2 is recommended for new integrations.",
    display_conditions = {
        show: {
            authentication: ["accessToken"]
        }
    };
*/

-- Exemple 5: Stripe utilise API Key
/*
RELATE service:stripe->uses_credential->credential_type:stripe_api SET
    is_required = true,
    is_recommended = true,
    display_order = 1;
*/

-- =====================================================
-- REQUÊTES UTILES
-- =====================================================

-- Récupérer tous les credentials d'un service
-- SELECT ->uses_credential->credential_type.* FROM service:google_sheets;

-- OU de manière plus explicite:
/*
SELECT 
    credential_type.*,
    uses_credential.is_required,
    uses_credential.is_recommended,
    uses_credential.display_order
FROM uses_credential
WHERE in = service:google_sheets
ORDER BY display_order;
*/

-- Récupérer tous les services qui utilisent un credential_type
/*
SELECT 
    service.*
FROM uses_credential
WHERE out = credential_type:google_sheets_oauth2;
*/

-- Récupérer seulement les credentials obligatoires d'un service
/*
SELECT 
    credential_type.*
FROM uses_credential
WHERE in = service:google_sheets
  AND is_required = true;
*/

-- Récupérer le credential recommandé d'un service
/*
SELECT 
    credential_type.*
FROM uses_credential
WHERE in = service:google_sheets
  AND is_recommended = true
LIMIT 1;
*/

-- Compter combien de services utilisent chaque credential_type
/*
SELECT 
    out AS credential_type_id,
    count() AS service_count
FROM uses_credential
GROUP BY out
ORDER BY service_count DESC;
*/

-- Services qui ont plusieurs options de credentials
/*
SELECT 
    in AS service_id,
    count() AS credential_count
FROM uses_credential
GROUP BY in
HAVING credential_count > 1;
*/

-- Trouver les credentials avec display_conditions
/*
SELECT 
    in AS service_id,
    out AS credential_type_id,
    display_conditions
FROM uses_credential
WHERE display_conditions IS NOT NONE;
*/

-- Récupérer la configuration complète pour un service
/*
SELECT 
    service.*,
    array::group({
        credential: credential_type.*,
        is_required: uses_credential.is_required,
        is_recommended: uses_credential.is_recommended,
        custom_label: uses_credential.custom_label,
        display_order: uses_credential.display_order
    }) AS credentials
FROM service
LEFT JOIN uses_credential ON uses_credential.in = service.id
LEFT JOIN credential_type ON uses_credential.out = credential_type.id
WHERE service.id = service:google_sheets
GROUP BY service.id;
*/

-- =====================================================
-- VALIDATION ET MAINTENANCE
-- =====================================================

-- Vérifier les relations orphelines (service n'existe pas)
-- SELECT * FROM uses_credential WHERE in NOT IN (SELECT id FROM service);

-- Vérifier les relations orphelines (credential_type n'existe pas)
-- SELECT * FROM uses_credential WHERE out NOT IN (SELECT id FROM credential_type);

-- Services sans credentials (potentiellement problématique)
/*
SELECT * FROM service 
WHERE id NOT IN (
    SELECT DISTINCT in FROM uses_credential
);
*/

-- Credentials qui ne sont utilisés par aucun service
/*
SELECT * FROM credential_type 
WHERE id NOT IN (
    SELECT DISTINCT out FROM uses_credential
);
*/

