CREATE i18n_translation:1487686 SET
    i18n_key_id: i18n_key:parameter_zulip_stream_getMany_authorizationErrorsFatal_desc,
    language_code: 'fr',
    translated_text: 'Whether authorization errors (such as when the requesting user is not authorized to access a private stream) should be considered fatal or not. When True, an authorization error is reported as such. When set to False, the returned JSON payload indicates that there was an authorization error, but the response is still considered a successful one.',
    is_active: true;

