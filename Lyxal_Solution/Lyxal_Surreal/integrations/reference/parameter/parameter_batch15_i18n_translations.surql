CREATE i18n_translation:887906 SET
    i18n_key_id: i18n_key:parameter_pagerduty_user_get_sortBy_desc,
    language_code: 'fr',
    translated_text: 'Used to specify both the field you wish to sort the results on (incident_number/created_at/resolved_at/urgency), as well as the direction (asc/desc) of the results. The sort_by field and direction should be separated by a colon. A maximum of two fields can be included, separated by a comma.',
