CREATE i18n_translation:1212666 SET
    i18n_key_id: i18n_key:parameter_shopify_order_get_src_desc,
    language_code: 'fr',
    translated_text: '<p>Specifies the location of the product image. This parameter supports URL filters that you can use to retrieve modified copies of the image.</p><p>For example, add _small, to the filename to retrieve a scaled copy of the image at 100 x 100 px (for example, ipod-nano_small.png), or add _2048x2048 to retrieve a copy of the image constrained at 2048 x 2048 px resolution (for example, ipod-nano_2048x2048.png).</p>.',
    is_active: true;

CREATE i18n_translation:1212667 SET
    i18n_key_id: i18n_key:parameter_shopify_order_get_src_desc,
    language_code: 'en',
    translated_text: '<p>Specifies the location of the product image. This parameter supports URL filters that you can use to retrieve modified copies of the image.</p><p>For example, add _small, to the filename to retrieve a scaled copy of the image at 100 x 100 px (for example, ipod-nano_small.png), or add _2048x2048 to retrieve a copy of the image constrained at 2048 x 2048 px resolution (for example, ipod-nano_2048x2048.png).</p>.',
    is_active: true;

