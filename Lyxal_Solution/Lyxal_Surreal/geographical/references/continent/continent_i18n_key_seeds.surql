CREATE i18n_key:continent_af_name SET description = "Nom pour le continent Afrique";
CREATE i18n_key:continent_an_name SET description = "Nom pour le continent Antarctique";
CREATE i18n_key:continent_as_name SET description = "Nom pour le continent Asie";
CREATE i18n_key:continent_eu_name SET description = "Nom pour le continent Europe";
CREATE i18n_key:continent_na_name SET description = "Nom pour le continent Amérique du Nord";
CREATE i18n_key:continent_oc_name SET description = "Nom pour le continent Océanie";
CREATE i18n_key:continent_sa_name SET description = "Nom pour le continent Amérique du Sud";
