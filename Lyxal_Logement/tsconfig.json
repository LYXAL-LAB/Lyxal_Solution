{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./ui/*"],
      "@hooks/*": ["./ui/hooks/*"],
      "@services/*": ["./ui/services/*"],
      "@utils/*": ["./ui/utils/*"],
      "@pages/*": ["./ui/pages/*"]
    },
    "composite": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "ui/**/*"
  ]
} 