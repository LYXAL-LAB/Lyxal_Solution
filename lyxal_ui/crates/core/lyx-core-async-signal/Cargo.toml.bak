[workspace]
resolver = "2"
members = ["src", "sample-crumbs", "tests_ssr"]

[workspace.dependencies]
leptos = "0.7.0"
tokio = { version = "1", features = ["full"] }
serde = { version = "1", features = ["derive"] } 



[patch.crates-io]
leptos = { path = "../lyx-core-leptos/leptos" }
leptos_meta = { path = "../lyx-core-leptos/meta" }
leptos_router = { path = "../lyx-core-leptos/router" }
leptos_axum = { path = "../lyx-core-leptos/integrations/axum" }
leptos_actix = { path = "../lyx-core-leptos/integrations/actix" }
leptos_dom = { path = "../lyx-core-leptos/leptos_dom" }
leptos_macro = { path = "../lyx-core-leptos/leptos_macro" }
leptos_server = { path = "../lyx-core-leptos/leptos_server" }
leptos_config = { path = "../lyx-core-leptos/leptos_config" }
reactive_graph = { path = "../lyx-core-leptos/reactive_graph" }
reactive_stores = { path = "../lyx-core-leptos/reactive_stores" }
reactive_stores_macro = { path = "../lyx-core-leptos/reactive_stores_macro" }
server_fn = { path = "../lyx-core-leptos/server_fn" }
server_fn_macro = { path = "../lyx-core-leptos/server_fn_macro" }
tachys = { path = "../lyx-core-leptos/tachys" }
hydration_context = { path = "../lyx-core-leptos/hydration_context" }
throw_error = { path = "../lyx-core-leptos/any_error" }
any_spawner = { path = "../lyx-core-leptos/any_spawner" }
either_of = { path = "../lyx-core-leptos/either_of" }
oco_ref = { path = "../lyx-core-leptos/oco" }
or_poisoned = { path = "../lyx-core-leptos/or_poisoned" }
next_tuple = { path = "../lyx-core-leptos/next_tuple" }
leptos-use = { path = "../../logic/lyx-logic-use" }
tailwind_fuse = { path = "../../ui-foundations/lyx-found-tailwind/fuse" }
