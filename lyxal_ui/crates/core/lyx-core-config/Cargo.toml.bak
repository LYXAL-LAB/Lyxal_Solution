[workspace]
resolver = "2"
package.license = "MIT OR Apache-2.0"
package.homepage = "https://juspay.io/open-source/superposition"
package.repository = "https://github.com/juspay/superposition"
package.readme = "README.md"
package.authors = ["superposition@juspay.in"]
package.version = "0.98.0"
package.rust-version = "1.85.0"
package.edition = "2024"

members = [
    "crates/service_utils",
    "crates/context_aware_config",
    "crates/experimentation_platform",
    "crates/experimentation_client",
    "crates/cac_client",
    "crates/frontend",
    "crates/cac_toml",
    "crates/superposition",
    "crates/superposition_types",
    "crates/superposition_macros",
    "crates/superposition_derives",
    "crates/superposition_core",
    "crates/superposition_provider",
    "crates/superposition_sdk",
    "examples/experimentation_client_integration_example",
    "examples/cac_client_integration_example",
    "examples/superposition-demo-app",
]

[[workspace.metadata.leptos]]
name = "cac"
bin-package = "juspay_superposition"
output-name = "frontend"
lib-package = "frontend"
site-root = "target/site"
site-pkg-dir = "pkg"
style-file = "crates/frontend/styles/style.css"
assets-dir = "crates/frontend/assets"

[workspace.dependencies]
actix-web = "4.5.0"
anyhow = "1.0.75"
aws-sdk-kms = { version = "1.38.0" }
base64 = "0.21.2"
bigdecimal = { version = "0.3.1", features = ["serde"] }
cfg-if = "1.0.0"
chrono = { version = "0.4.26", features = ["serde"] }
derive_more = "^0.99"
diesel = { version = "2.2.4", package = "juspay_diesel", features = [
    "postgres",
    "r2d2",
    "serde_json",
    "chrono",
    "uuid",
    "postgres_backend",
    "numeric",
] }
fred = { version = "9.2.1" }
futures-util = "0.3.28"
itertools = { version = "0.10.5" }
jsonlogic = { version = "0.5.5", package = "juspay_jsonlogic" }
jsonschema = "~0.17"
leptos = { version = "0.6.11" }
log = { version = "0.4.20", features = ["kv_unstable_serde"] }
once_cell = { version = "1.18.0" }
regex = "1.9.1"
reqwest = { version = "0.11.18", features = ["json"] }
rs-snowflake = "0.6.0"
serde = { version = "^1", features = ["derive"] }
serde_json = { version = "1.0.140" }
secrecy = "0.10"
strum = "0.25"
strum_macros = "0.25"
toml = { version = "0.8.8", features = ["preserve_order"] }
actix-http = "3.3.1"
tracing = "0.1.44"
tracing-subscriber = { version = "0.3.22", features = ["env-filter", "fmt", "json"] }
tracing-actix-web = "0.7.21"
url = "2.5.0"
uuid = { version = "1.20.0", features = ["v4", "serde", "js"] }
uniffi = { version = "0.29.3", features = [ "cli" ] }
superposition = { path = "./crates/superposition", version = "0.98.0" }
superposition_types = { path = "./crates/superposition_types", version = "0.98.0" }
superposition_derives = { path = "./crates/superposition_derives", version = "0.98.0" }
superposition_macros = { path = "./crates/superposition_macros", version = "0.98.0" }
superposition_core = { path = "./crates/superposition_core", version = "0.98.0" }
superposition_provider = { path = "./crates/superposition_provider", version = "0.98.0" }
superposition_sdk = { path = "./crates/superposition_sdk", version = "0.98.0" }
service_utils = { path = "./crates/service_utils", version = "0.98.0" }

[workspace.lints.clippy]
mod_module_files = "warn"
manual_range_contains = "allow"


[patch.crates-io]
leptos = { path = "../lyx-core-leptos/leptos" }
leptos_meta = { path = "../lyx-core-leptos/meta" }
leptos_router = { path = "../lyx-core-leptos/router" }
leptos_axum = { path = "../lyx-core-leptos/integrations/axum" }
leptos_actix = { path = "../lyx-core-leptos/integrations/actix" }
leptos_dom = { path = "../lyx-core-leptos/leptos_dom" }
leptos_macro = { path = "../lyx-core-leptos/leptos_macro" }
leptos_server = { path = "../lyx-core-leptos/leptos_server" }
leptos_config = { path = "../lyx-core-leptos/leptos_config" }
reactive_graph = { path = "../lyx-core-leptos/reactive_graph" }
reactive_stores = { path = "../lyx-core-leptos/reactive_stores" }
reactive_stores_macro = { path = "../lyx-core-leptos/reactive_stores_macro" }
server_fn = { path = "../lyx-core-leptos/server_fn" }
server_fn_macro = { path = "../lyx-core-leptos/server_fn_macro" }
tachys = { path = "../lyx-core-leptos/tachys" }
hydration_context = { path = "../lyx-core-leptos/hydration_context" }
throw_error = { path = "../lyx-core-leptos/any_error" }
any_spawner = { path = "../lyx-core-leptos/any_spawner" }
either_of = { path = "../lyx-core-leptos/either_of" }
oco_ref = { path = "../lyx-core-leptos/oco" }
or_poisoned = { path = "../lyx-core-leptos/or_poisoned" }
next_tuple = { path = "../lyx-core-leptos/next_tuple" }
leptos-use = { path = "../../logic/lyx-logic-use" }
tailwind_fuse = { path = "../../ui-foundations/lyx-found-tailwind/fuse" }
