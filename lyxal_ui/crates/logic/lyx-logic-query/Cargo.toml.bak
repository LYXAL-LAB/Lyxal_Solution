
[workspace.dependencies]
leptos = { version = "0.0.1", path = "../../core/lyx-core-leptos/leptos" }
cfg-if = "1"
js-sys = { version = "0.3" }
gloo-timers = { version = "0.3", features = ["futures"] }
tokio = { version = "1", features = ["time"] }
slotmap = "1"
futures-channel = "0.3"
futures = "0.3"
web-sys = "0.3"


