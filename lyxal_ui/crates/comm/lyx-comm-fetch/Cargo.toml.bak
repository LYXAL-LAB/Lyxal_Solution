[workspace]
members = ["leptos-fetch", "examples/*"]
resolver = "3"

[workspace.package]
version = "0.4.9"
repository = "https://github.com/zakstucke/leptos-fetch"
license = "MIT"
authors = ["Zak Stucke"]
edition = "2024"
keywords = ["leptos"]
description = "Async query manager for Leptos"
readme = "./leptos-fetch/README.md"
rust-version = "1.88"

[workspace.dependencies]
any_spawner = "0.3.0"
hydration_context = "0.3.0"
codee = "0.3"
reactive_graph = "0.2.10"
leptos = "0.8.13"

chrono = "0.4"
chrono-humanize = "0.2"
futures = "0.3"
paste = "1"
parking_lot = "0.12"
pin-project-lite = "0.2"
send_wrapper = "0.6"

# An extraction of the tokio task local into a standalone crate
task-local = "0.1"

web-sys = { version = "0.3", features = ["DomRect"] }
tracing = "0.1"

[patch.crates-io]
leptos = { path = "../../core/lyx-core-leptos/leptos" }
leptos_meta = { path = "../../core/lyx-core-leptos/meta" }
leptos_router = { path = "../../core/lyx-core-leptos/router" }
leptos_axum = { path = "../../core/lyx-core-leptos/integrations/axum" }
leptos_actix = { path = "../../core/lyx-core-leptos/integrations/actix" }
leptos_dom = { path = "../../core/lyx-core-leptos/leptos_dom" }
leptos_macro = { path = "../../core/lyx-core-leptos/leptos_macro" }
leptos_server = { path = "../../core/lyx-core-leptos/leptos_server" }
leptos_config = { path = "../../core/lyx-core-leptos/leptos_config" }
reactive_graph = { path = "../../core/lyx-core-leptos/reactive_graph" }
reactive_stores = { path = "../../core/lyx-core-leptos/reactive_stores" }
reactive_stores_macro = { path = "../../core/lyx-core-leptos/reactive_stores_macro" }
server_fn = { path = "../../core/lyx-core-leptos/server_fn" }
server_fn_macro = { path = "../../core/lyx-core-leptos/server_fn_macro" }
tachys = { path = "../../core/lyx-core-leptos/tachys" }
hydration_context = { path = "../../core/lyx-core-leptos/hydration_context" }
throw_error = { path = "../../core/lyx-core-leptos/any_error" }
any_spawner = { path = "../../core/lyx-core-leptos/any_spawner" }
either_of = { path = "../../core/lyx-core-leptos/either_of" }
oco_ref = { path = "../../core/lyx-core-leptos/oco" }
or_poisoned = { path = "../../core/lyx-core-leptos/or_poisoned" }
next_tuple = { path = "../../core/lyx-core-leptos/next_tuple" }
leptos-use = { path = "../../logic/lyx-logic-use" }
tailwind_fuse = { path = "../../ui-foundations/lyx-found-tailwind/fuse" }
