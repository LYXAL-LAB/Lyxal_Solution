-- Configuration Application Production
DEFINE TABLE app_production SCHEMAFULL;
DEFINE FIELD name ON app_production TYPE string DEFAULT "Business Production";
DEFINE FIELD code ON app_production TYPE string DEFAULT "business-production";
DEFINE FIELD is_active ON app_production TYPE bool DEFAULT true;
DEFINE FIELD sequence ON app_production TYPE int DEFAULT 40;
DEFINE FIELD depends_on_set ON app_production TYPE array<string>;
DEFINE FIELD manage_work_center ON app_production TYPE bool DEFAULT true;
DEFINE FIELD manage_operation_order ON app_production TYPE bool DEFAULT true;
DEFINE FIELD manage_production_order ON app_production TYPE bool DEFAULT true;
DEFINE FIELD manage_manufacturing_order ON app_production TYPE bool DEFAULT true;
DEFINE FIELD auto_generate_operation_order ON app_production TYPE bool DEFAULT false;
DEFINE FIELD production_order_sequence ON app_production TYPE record<sequence>;
DEFINE FIELD manuf_order_sequence ON app_production TYPE record<sequence>;
DEFINE FIELD operation_order_sequence ON app_production TYPE record<sequence>;
DEFINE FIELD default_work_center ON app_production TYPE record<work_center>;
DEFINE FIELD default_stock_location ON app_production TYPE record<stock_location>;
DEFINE FIELD enable_project_integration ON app_production TYPE bool DEFAULT true;
DEFINE FIELD enable_timesheet_integration ON app_production TYPE bool DEFAULT true;
DEFINE FIELD enable_invoicing_project ON app_production TYPE bool DEFAULT true;
DEFINE FIELD created_at ON app_production TYPE datetime DEFAULT time::now();
DEFINE FIELD updated_at ON app_production TYPE datetime DEFAULT time::now();
DEFINE FIELD version ON app_production TYPE int DEFAULT 0;