{
  "name": "Lyxal Professional",
  "version": "1.0.0",
  "description": "Configuration complète pour entreprises professionnelles",
  "target": "medium_business",
  "modules": {
    "base": {
      "enabled": true,
      "submodules": {
        "geographic": {
          "enabled": true,
          "entities": {
            "continent": true,
            "country": true,
            "region": true,
            "subregion": false
          }
        },
        "currency": {
          "enabled": true
        },
        "organisation": {
          "enabled": true
        },
        "planning": {
          "enabled": true
        }
      }
    },
    "crm": {
      "enabled": true,
      "submodules": {
        "lead_management": true,
        "opportunity": true,
        "customer_service": true
      }
    },
    "accounting": {
      "enabled": true,
      "submodules": {
        "general_ledger": true,
        "invoicing": true,
        "payment": true,
        "tax_management": true
      }
    },
    "production": {
      "enabled": false
    },
    "human_resource": {
      "enabled": true,
      "submodules": {
        "employee_management": true,
        "timesheet": true,
        "expense": true,
        "leave_management": true
      }
    },
    "project": {
      "enabled": true
    },
    "purchase": {
      "enabled": true
    },
    "sale": {
      "enabled": true
    }
  },
  "database": {
    "namespace": "lyxal_professional",
    "database": "main",
    "url": "ws://127.0.0.1:8000"
  },
  "options": {
    "force_reinstall": false,
    "skip_validation": false,
    "enable_demo_data": false,
    "enable_audit_log": true
  },
  "features": {
    "multi_tenant": true,
    "api_access": "advanced",
    "storage_limit": "50GB",
    "user_limit": 100
  },
  "integrations": {
    "email": {
      "enabled": true,
      "provider": "smtp"
    },
    "calendar": {
      "enabled": true,
      "provider": "caldav"
    },
    "reporting": {
      "enabled": true,
      "formats": ["pdf", "excel", "csv"]
    }
  },
  "security": {
    "authentication": {
      "method": "ldap",
      "two_factor": true
    },
    "encryption": {
      "database": true,
      "files": true
    },
    "backup": {
      "enabled": true,
      "frequency": "daily",
      "retention": "30_days"
    }
  },
  "metadata": {
    "created_at": "2025-01-18T00:00:00Z",
    "created_by": "Lyxal Team",
    "use_cases": [
      "Entreprise moyenne",
      "Gestion complète",
      "Intégrations avancées",
      "Multi-utilisateurs"
    ]
  }
} 