{
  "name": "Lyxal Starter",
  "version": "1.0.0",
  "description": "Configuration minimale pour débuter avec Lyxal",
  "target": "small_business",
  "modules": {
    "base": {
      "enabled": true,
      "submodules": {
        "geographic": {
          "enabled": true,
          "entities": {
            "continent": true,
            "country": false,
            "region": false,
            "subregion": false
          }
        },
        "currency": {
          "enabled": false
        },
        "organisation": {
          "enabled": false
        },
        "planning": {
          "enabled": false
        }
      }
    },
    "crm": {
      "enabled": false
    },
    "accounting": {
      "enabled": false
    },
    "production": {
      "enabled": false
    },
    "human_resource": {
      "enabled": false
    }
  },
  "database": {
    "namespace": "lyxal_starter",
    "database": "main",
    "url": "ws://127.0.0.1:8000"
  },
  "options": {
    "force_reinstall": false,
    "skip_validation": false,
    "enable_demo_data": true,
    "enable_audit_log": false
  },
  "features": {
    "multi_tenant": false,
    "api_access": "basic",
    "storage_limit": "1GB",
    "user_limit": 5
  },
  "metadata": {
    "created_at": "2025-01-18T00:00:00Z",
    "created_by": "Lyxal Team",
    "use_cases": [
      "Petite entreprise",
      "Test et développement",
      "Découverte de Lyxal"
    ]
  }
} 