-- =============================================================================
-- FONCTION: fn::get_all_categories_with_hierarchy
-- =============================================================================
-- DESCRIPTION: Récupère toutes les catégories juridiques avec leur hiérarchie complète
-- PARAMETRES: Aucun
-- RETOUR: Array contenant toutes les catégories avec leur hiérarchie et chemin
-- USAGE:
--   -- Récupérer toutes les catégories:
--   RETURN fn::get_all_categories_with_hierarchy();
-- =============================================================================

DEFINE FUNCTION OVERWRITE fn::get_all_categories_with_hierarchy() {
    RETURN (
        SELECT 
            *,
            fn::get_category_hierarchy(id) AS hierarchy
        FROM legal_category 
        ORDER BY level, name
    );
} COMMENT "Récupère toutes les catégories juridiques avec leur hiérarchie complète. Utilise fn::get_category_hierarchy pour chaque catégorie.";

-- =============================================================================
-- FONCTION: fn::get_active_categories_with_hierarchy  
-- =============================================================================
-- DESCRIPTION: Récupère seulement les catégories actives avec leur hiérarchie
-- PARAMETRES: Aucun
-- RETOUR: Array contenant les catégories actives avec leur hiérarchie
-- USAGE:
--   -- Récupérer les catégories actives:
--   RETURN fn::get_active_categories_with_hierarchy();
-- =============================================================================

DEFINE FUNCTION OVERWRITE fn::get_active_categories_with_hierarchy() {
    RETURN (
        SELECT 
            *,
            fn::get_category_hierarchy(id) AS hierarchy
        FROM legal_category 
        WHERE active = true
        ORDER BY level, name
    );
} COMMENT "Récupère seulement les catégories juridiques actives avec leur hiérarchie complète.";

