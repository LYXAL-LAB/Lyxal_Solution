-- =================================================
-- TABLE : sale_order_line - Ligne de commande de vente
-- =================================================

DEFINE TABLE sale_order_line SCHEMAFULL;
    COMMENT "Ligne de commande de vente";

DEFINE FIELD full_name ON sale_order_line TYPE string;
DEFINE FIELD sale_order ON sale_order_line TYPE record<sale_order>;
DEFINE FIELD sequence ON sale_order_line TYPE int;
DEFINE FIELD product ON sale_order_line TYPE record<product>;
DEFINE FIELD qty ON sale_order_line TYPE float DEFAULT 1;
DEFINE FIELD old_qty ON sale_order_line TYPE float;
DEFINE FIELD is_to_print_line_sub_total ON sale_order_line TYPE bool DEFAULT false;
DEFINE FIELD product_name ON sale_order_line TYPE string;
DEFINE FIELD price ON sale_order_line TYPE float;
DEFINE FIELD in_tax_price ON sale_order_line TYPE float;
DEFINE FIELD price_discounted ON sale_order_line TYPE float;
DEFINE FIELD pricing_scale_logs ON sale_order_line TYPE string;
DEFINE FIELD ex_tax_total ON sale_order_line TYPE float;
DEFINE FIELD in_tax_total ON sale_order_line TYPE float;
DEFINE FIELD description ON sale_order_line TYPE string;
DEFINE FIELD unit ON sale_order_line TYPE record<unit>;
DEFINE FIELD supplier_partner ON sale_order_line TYPE record<partner>;
DEFINE FIELD discount_amount ON sale_order_line TYPE float;
DEFINE FIELD discount_type_select ON sale_order_line TYPE int DEFAULT 0;
DEFINE FIELD estimated_shipping_date ON sale_order_line TYPE date;
DEFINE FIELD desired_delivery_date ON sale_order_line TYPE date;
DEFINE FIELD estimated_delivery_date ON sale_order_line TYPE date;
DEFINE FIELD delivered_qty ON sale_order_line TYPE float;
DEFINE FIELD delivery_address ON sale_order_line TYPE string;
DEFINE FIELD delivery_address_str ON sale_order_line TYPE string;
DEFINE FIELD version_number ON sale_order_line TYPE int DEFAULT 1;
DEFINE FIELD version_date_t ON sale_order_line TYPE datetime;
DEFINE FIELD old_version_sale_order ON sale_order_line TYPE string;
DEFINE FIELD is_complementary_products_unhandled_yet ON sale_order_line TYPE bool DEFAULT false;
DEFINE FIELD is_complementary_partner_products_handled ON sale_order_line TYPE bool DEFAULT false;
DEFINE FIELD manual_id ON sale_order_line TYPE string;
DEFINE FIELD parent_id ON sale_order_line TYPE string;
DEFINE FIELD main_sale_order_line ON sale_order_line TYPE string;
DEFINE FIELD sub_total_cost_price ON sale_order_line TYPE float;
DEFINE FIELD sub_total_gross_margin ON sale_order_line TYPE float;
DEFINE FIELD sub_margin_rate ON sale_order_line TYPE float;
DEFINE FIELD sub_total_markup ON sale_order_line TYPE float;
DEFINE FIELD company_ex_tax_total ON sale_order_line TYPE float;
DEFINE FIELD company_cost_price ON sale_order_line TYPE float;
DEFINE FIELD company_in_tax_total ON sale_order_line TYPE float;
DEFINE FIELD company_cost_total ON sale_order_line TYPE float;
DEFINE FIELD type_select ON sale_order_line TYPE int DEFAULT 0;
DEFINE FIELD type_select_normal ON sale_order_line TYPE int DEFAULT 0;
DEFINE FIELD is_show_total ON sale_order_line TYPE bool DEFAULT false;
DEFINE FIELD is_hide_unit_amounts ON sale_order_line TYPE bool DEFAULT false;
DEFINE FIELD enable_freeze_fields ON sale_order_line TYPE bool DEFAULT false;
DEFINE FIELD discounts_need_review ON sale_order_line TYPE bool DEFAULT false;
DEFINE FIELD discount_derogation ON sale_order_line TYPE float;
DEFINE FIELD line_production_comment ON sale_order_line TYPE string;
DEFINE FIELD parent_sale_order_line ON sale_order_line TYPE string;
DEFINE FIELD level_indicator ON sale_order_line TYPE string;
DEFINE FIELD currency ON sale_order_line TYPE record<currency>;
DEFINE FIELD company_currency ON sale_order_line TYPE  string;
DEFINE FIELD product_type_icon_select ON sale_order_line TYPE string;
DEFINE FIELD configurator ON sale_order_line TYPE record<configurator>;
DEFINE FIELD created_on ON sale_order_line TYPE datetime DEFAULT time::now();
DEFINE FIELD updated_on ON sale_order_line TYPE datetime DEFAULT time::now();