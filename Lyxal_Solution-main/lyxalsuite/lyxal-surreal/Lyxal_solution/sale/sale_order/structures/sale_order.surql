-- =================================================
-- TABLE : sale_order - Commande de vente
-- =================================================

DEFINE TABLE sale_order SCHEMAFULL;
    COMMENT "Commande de vente";

DEFINE FIELD company ON sale_order TYPE record<company>;
DEFINE FIELD full_name ON sale_order TYPE string;
DEFINE FIELD sale_order_seq ON sale_order TYPE string;
DEFINE FIELD currency ON sale_order TYPE record<currency>;
DEFINE FIELD external_reference ON sale_order TYPE string;
DEFINE FIELD creation_date ON sale_order TYPE date;
DEFINE FIELD confirmation_date_time ON sale_order TYPE datetime;
DEFINE FIELD blocked_on_cust_credit_exceed ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD manual_unblock ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD title ON sale_order TYPE string;
DEFINE FIELD oneoff_sale ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD client_partner ON sale_order TYPE record<partner>;
DEFINE FIELD main_invoicing_address ON sale_order TYPE string;
DEFINE FIELD main_invoicing_address_str ON sale_order TYPE string;
DEFINE FIELD price_list ON sale_order TYPE string;
DEFINE FIELD delivery_address ON sale_order TYPE string;
DEFINE FIELD delivery_address_str ON sale_order TYPE string;
DEFINE FIELD is_to_print_line_sub_total ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD in_ati ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD duration ON sale_order TYPE string;
DEFINE FIELD end_of_validity_date ON sale_order TYPE date;
DEFINE FIELD ex_tax_total ON sale_order TYPE float;
DEFINE FIELD tax_total ON sale_order TYPE float;
DEFINE FIELD in_tax_total ON sale_order TYPE float;
DEFINE FIELD advance_total ON sale_order TYPE float;
DEFINE FIELD amount_to_be_spread_over_the_timetable ON sale_order TYPE float;
DEFINE FIELD company_ex_tax_total ON sale_order TYPE float;
DEFINE FIELD company_cost_total ON sale_order TYPE float;
DEFINE FIELD status_select ON sale_order TYPE int DEFAULT 1;
DEFINE FIELD accounted_revenue ON sale_order TYPE float;
DEFINE FIELD total_cost_price ON sale_order TYPE float;
DEFINE FIELD total_gross_margin ON sale_order TYPE float;
DEFINE FIELD margin_rate ON sale_order TYPE float;
DEFINE FIELD markup ON sale_order TYPE float;
DEFINE FIELD salesperson_user ON sale_order TYPE record<user>;
DEFINE FIELD team ON sale_order TYPE string;
DEFINE FIELD description ON sale_order TYPE string;
DEFINE FIELD internal_note ON sale_order TYPE string;
DEFINE FIELD order_date ON sale_order TYPE date;
DEFINE FIELD order_number ON sale_order TYPE string;
DEFINE FIELD confirmed_by_user ON sale_order TYPE string;
DEFINE FIELD template ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD version_number ON sale_order TYPE int DEFAULT 1;
DEFINE FIELD cancel_reason ON sale_order TYPE string;
DEFINE FIELD cancel_reason_str ON sale_order TYPE string;
DEFINE FIELD template_user ON sale_order TYPE string;
DEFINE FIELD hide_discount ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD estimated_shipping_date ON sale_order TYPE date;
DEFINE FIELD estimated_delivery_date ON sale_order TYPE date;
DEFINE FIELD delivery_condition ON sale_order TYPE string;
DEFINE FIELD specific_package ON sale_order TYPE string;
DEFINE FIELD advance_payment_needed ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD advance_payment_amount_needed ON sale_order TYPE float;
DEFINE FIELD company_bank_details ON sale_order TYPE string;
DEFINE FIELD discount_type_select ON sale_order TYPE int DEFAULT 0;
DEFINE FIELD discount_amount ON sale_order TYPE float;
DEFINE FIELD price_before_global_discount ON sale_order TYPE float;
DEFINE FIELD specific_notes ON sale_order TYPE string;
DEFINE FIELD order_being_edited ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD opportunity ON sale_order TYPE string;
DEFINE FIELD trading_name ON sale_order TYPE string;
DEFINE FIELD printing_settings ON sale_order TYPE string;
DEFINE FIELD group_products_on_printings ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD periodicity_type_select ON sale_order TYPE int DEFAULT 2;
DEFINE FIELD number_of_periods ON sale_order TYPE int DEFAULT 1;
DEFINE FIELD contract_start_date ON sale_order TYPE date;
DEFINE FIELD contract_period_in_months ON sale_order TYPE int;
DEFINE FIELD current_contract_period_end_date ON sale_order TYPE date;
DEFINE FIELD contract_end_date ON sale_order TYPE date;
DEFINE FIELD is_tacit_agreement ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD notice_period_in_days ON sale_order TYPE int;
DEFINE FIELD next_invoicing_date ON sale_order TYPE date;
DEFINE FIELD next_invoicing_start_period_date ON sale_order TYPE date;
DEFINE FIELD next_invoicing_end_period_date ON sale_order TYPE date;
DEFINE FIELD subscription_comment ON sale_order TYPE string;
DEFINE FIELD subscription_text ON sale_order TYPE string;
DEFINE FIELD invoice_comments ON sale_order TYPE string;
DEFINE FIELD delivery_comments ON sale_order TYPE string;
DEFINE FIELD picking_order_comments ON sale_order TYPE string;
DEFINE FIELD proforma_comments ON sale_order TYPE string;
DEFINE FIELD last_reminder_date ON sale_order TYPE date;
DEFINE FIELD last_reminder_comments ON sale_order TYPE string;
DEFINE FIELD fiscal_position ON sale_order TYPE string;
DEFINE FIELD tax_number ON sale_order TYPE string;
DEFINE FIELD company_currency ON sale_order TYPE string;
DEFINE FIELD is_display_sub_lines_on_report ON sale_order TYPE bool DEFAULT false;
DEFINE FIELD created_on ON sale_order TYPE datetime DEFAULT time::now();
DEFINE FIELD updated_on ON sale_order TYPE datetime DEFAULT time::now();
