-- ================================================
-- MODULE AXELOR STOCK - MOUVEMENTS ET INVENTAIRES
-- ================================================

-- Table stock_move
DEFINE TABLE stock_move SCHEMAFULL;
DEFINE FIELD id ON stock_move TYPE record<stock_move>;
DEFINE FIELD stock_move_seq ON stock_move TYPE string;
DEFINE FIELD name ON stock_move TYPE string;
DEFINE FIELD from_stock_location ON stock_move TYPE string;
DEFINE FIELD to_stock_location ON stock_move TYPE string;
DEFINE FIELD estimated_date ON stock_move TYPE date;
DEFINE FIELD real_date ON stock_move TYPE date;
DEFINE FIELD supplier_shipment_date ON stock_move TYPE date;
DEFINE FIELD supplier_shipment_ref ON stock_move TYPE string;
DEFINE FIELD status_select ON stock_move TYPE int DEFAULT 1;
DEFINE FIELD type_select ON stock_move TYPE int;
DEFINE FIELD available_status_select ON stock_move TYPE int;
DEFINE FIELD from_address ON stock_move TYPE string;
DEFINE FIELD to_address ON stock_move TYPE string;
DEFINE FIELD from_address_str ON stock_move TYPE string;
DEFINE FIELD to_address_str ON stock_move TYPE string;
DEFINE FIELD company ON stock_move TYPE string;
DEFINE FIELD partner ON stock_move TYPE string;
DEFINE FIELD is_with_return_surplus ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD is_with_backorder ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD tracking_number ON stock_move TYPE string;
DEFINE FIELD num_of_packages ON stock_move TYPE int;
DEFINE FIELD num_of_palettes ON stock_move TYPE int;
DEFINE FIELD gross_mass ON stock_move TYPE float;
DEFINE FIELD ex_tax_total ON stock_move TYPE float;
DEFINE FIELD shipment_mode ON stock_move TYPE string;
DEFINE FIELD freight_carrier_mode ON stock_move TYPE string;
DEFINE FIELD carrier_partner ON stock_move TYPE string;
DEFINE FIELD forwarder_partner ON stock_move TYPE string;
DEFINE FIELD incoterm ON stock_move TYPE string;
DEFINE FIELD conformity_select ON stock_move TYPE int;
DEFINE FIELD fully_spread_over_logistical_forms_flag ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD cancel_reason ON stock_move TYPE string;
DEFINE FIELD planned_stock_move_automatic_mail ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD planned_stock_move_message_template ON stock_move TYPE string;
DEFINE FIELD real_stock_move_automatic_mail ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD real_stock_move_message_template ON stock_move TYPE string;
DEFINE FIELD trading_name ON stock_move TYPE string;
DEFINE FIELD printing_settings ON stock_move TYPE string;
DEFINE FIELD group_products_on_printings ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD is_ispm_required ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD is_reversion ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD is_needing_conformity_certificate ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD is_conformity_certif_signed ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD cut_off_move_generated ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD electronic_signature ON stock_move TYPE string;
DEFINE FIELD signatory_user ON stock_move TYPE string;
DEFINE FIELD backorder_id ON stock_move TYPE int;
DEFINE FIELD stock_move_origin ON stock_move TYPE string;
DEFINE FIELD origin ON stock_move TYPE string;
DEFINE FIELD availability_request ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD stock_correction_reason ON stock_move TYPE string;
DEFINE FIELD picking_is_edited ON stock_move TYPE bool DEFAULT false;
DEFINE FIELD picking_edit_date ON stock_move TYPE date;
DEFINE FIELD mode_of_transport ON stock_move TYPE int;
DEFINE FIELD note ON stock_move TYPE string;
DEFINE FIELD filter_on_available_products ON stock_move TYPE bool DEFAULT true;
DEFINE FIELD reversion_origin_stock_move ON stock_move TYPE string;
DEFINE FIELD picking_order_comments ON stock_move TYPE string;
DEFINE FIELD inventory ON stock_move TYPE string;
DEFINE FIELD stock_correction ON stock_move TYPE string;
DEFINE FIELD mass_stock_move ON stock_move TYPE string;
DEFINE FIELD created_on ON stock_move TYPE datetime DEFAULT time::now();
DEFINE FIELD updated_on ON stock_move TYPE datetime DEFAULT time::now();

