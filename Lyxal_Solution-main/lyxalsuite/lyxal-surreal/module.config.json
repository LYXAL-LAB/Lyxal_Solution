{
  "name": "lyxal-surreal",
  "version": "1.0.0",
  "description": "🚀 Module de monitoring SurrealDB bicéphale - Architecture INVESTOR/DEVELOPER",
  "category": "infrastructure",
  "order": 2,
  "required": true,
  "database_files": [
    "monitoring_structure.surql",
    "monitoring_functions.surql",
    "monitoring_events.surql",
    "monitoring_permissions.surql"
  ],
  "dependencies": [],
  "levels": {
    "INVESTOR_LEVEL": {
      "namespace": "catalog",
      "databases": ["monitoring"],
      "use_cases": [
        "global_platform_health",
        "cross_saas_performance", 
        "platform_resource_usage",
        "global_error_tracking"
      ]
    },
    "DEVELOPER_LEVEL": {
      "namespace": "{saas_id}",
      "databases": ["monitoring", "workspace_{id}"],
      "use_cases": [
        "saas_performance_monitoring",
        "business_analytics",
        "operational_reporting",
        "saas_user_management"
      ]
    }
  },
  "verification": {
    "tables": {
      "INVESTOR_LEVEL": [
        "global_system_metrics",
        "global_saas_health",
        "cross_saas_analytics",
        "global_alerts"
      ],
      "DEVELOPER_LEVEL": [
        "saas_system_metrics",
        "saas_query_metrics",
        "saas_alerts",
        "workspace_metrics"
      ]
    },
    "functions": [
      "fn::calculate_global_health",
      "fn::cross_saas_performance_ranking",
      "fn::calculate_saas_performance",
      "fn::detect_slow_queries"
    ],
    "events": [
      "global_metrics_aggregation",
      "slow_query_detection",
      "performance_alert_trigger"
    ]
  },
  "features": [
    "bicephalous-architecture",
    "real-time-monitoring",
    "live-queries",
    "ai-driven-analytics",
    "multi-tenant-isolation",
    "automatic-alerting",
    "performance-optimization",
    "native-surrealdb-integration"
  ],
  "statistics": {
    "tables": 8,
    "functions": 6,
    "events": 4,
    "indexes": 25,
    "levels": 2,
    "schema_size_kb": 45,
    "estimated_lines": 1200
  },
  "architecture": {
    "type": "bicephalous",
    "levels": ["INVESTOR_LEVEL", "DEVELOPER_LEVEL"],
    "isolation": "namespace-based",
    "permissions": "granular",
    "real_time": true
  },
  "author": "LyxalSuite Team",
  "license": "MIT",
  "repository": "https://github.com/lyxalsuite/lyxalsuite.git"
} 