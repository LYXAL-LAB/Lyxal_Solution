{
  "name": "@lyxalsuite/lyxalauth",
  "version": "1.0.0",
  "description": "Module d'authentification centralisée pour LYXAL Suite",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev:gateway": "hono dev gateway/index.ts",
    "dev:sdk": "vite dev",
    "dev": "npm run dev:gateway",
    "build:gateway": "tsc --project tsconfig.gateway.json",
    "build:sdk": "vite build",
    "build": "npm run build:gateway && npm run build:sdk",
    "build:check": "tsc --noEmit",

    "lint": "eslint . --config ../.config/eslint.config.base.js",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "start": "node dist/gateway/index.js",
    "clean": "rimraf dist",
    "lint:fix": "eslint . --config ../.config/eslint.config.base.js --fix"
  },
  "dependencies": {
    "jose": "^5.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@hono/node-server": "^1.14.2",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "hono": "^4.7.10",
    "jest-environment-node": "^30.0.0-beta.3",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.10",
    "vite": "^5.1.0"
  },
  "author": "LYXAL Team",
  "license": "MIT"
}