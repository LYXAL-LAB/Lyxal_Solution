{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"],
      "@lyxal-surreal": ["../lyxal-surreal"],
      "@lyxal-surreal/*": ["../lyxal-surreal/*"]
    },
    "types": ["node"]
  },
  "include": [
    "src/**/*"
  ]
} 