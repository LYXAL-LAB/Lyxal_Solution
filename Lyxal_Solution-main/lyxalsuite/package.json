{
  "name": "lyxalsuite",
  "version": "1.0.0",
  "description": "LyxalSuite - Plateforme IA-Native Unifiée",
  "private": true,
  "workspaces": [
    "lyxal-*",
    "lyxalauth",
    "lyxalkitui"
  ],
  "scripts": {
    "start:minimal": "tsx scripts/start-minimal.ts",
    "init:platform": "tsx scripts/start-minimal.ts",
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "build:all": "tsc --build .config/tsconfig.projects.json",
    "test": "cd lyxal-test && npm run test",
    "test:all": "cd lyxal-test && npm run test:all",
    "test:coverage": "cd lyxal-test && npm run test:coverage:all",
    "test:watch": "cd lyxal-test && npm run test:watch",
    "lint": "npm run lint --workspaces",
    "lint:all": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "clean": "npm run clean --workspaces && rimraf dist build coverage",
    "typecheck": "tsc --noEmit --build .config/tsconfig.projects.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "echo '🚀 LyxalSuite Workspace installé ! Utilisez: npm run start:minimal'",
    "db:deploy:all": "cd lyxal-surreal/database && node deploy-central.js",
    "db:deploy:module": "cd lyxal-surreal/database && node deploy-central.js --module"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/jest": "^29.5.14",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.5.2",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.2",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.0",
    "vitest": "^1.1.3",
    "@vitest/ui": "^1.1.3"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "surrealdb.js": "^0.11.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lyxalsuite/lyxalsuite.git"
  },
  "author": "LyxalSuite Team",
  "license": "MIT",
  "keywords": [
    "lyxalsuite",
    "surrealdb",
    "ai-native",
    "erp",
    "workspace",
    "monorepo"
  ]
} 