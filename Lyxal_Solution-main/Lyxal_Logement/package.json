  "author": "LyxalSuite Team",
  "license": "Propritaire",
  "repository": {
    "type": "git",
    "url": "https://github.com/LYXAL-LAB/Lyxal_Solution.git",
    "directory": "Lyxal_Kit_UI"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/ui": "^4.0.6",
    "daisyui": "^5.1.13",
    "jsdom": "^27.1.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.6"
