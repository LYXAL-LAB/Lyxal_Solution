{
  "name": "lyxal-kit-ui",
  "version": "1.0.0",
  "description": "Lyxal Kit UI - Kit de composants UI pour l'écosystème LyxalSuite",
  "main": "ui/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --config ../.config/eslint.config.base.js",
    "lint:fix": "eslint . --config ../.config/eslint.config.base.js --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "lucide-react": "^0.294.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.25.1",
    "recharts": "^2.8.0",
    "zustand": "^5.0.8"
  },
  "keywords": [
    "lyxal",
    "lyxal-suite",
    "lyxal-kit-ui",
    "lyxal-kit-ui-components",
    "lyxal-kit-ui-templates",
    "lyxal-kit-ui-themes",
    "lyxal-kit-ui-utils",
    "lyxal-kit-ui-hooks",
    "lyxal-kit-ui-services",
    "lyxal-kit-ui-contexts"
