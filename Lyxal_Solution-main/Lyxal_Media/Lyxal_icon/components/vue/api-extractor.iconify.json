{
	"$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
	"mainEntryPointFilePath": "lib/Lyxal.d.ts",
	"bundledPackages": [
		"@lyxal-icon/core",
		"@lyxal-icon/utils",
		"@lyxal-icon/api-redundancy",
		"lyxal-icon"
	],
	"compiler": {},
	"apiReport": {
		"enabled": false
	},
	"docModel": {
		"enabled": false
	},
	"dtsRollup": {
		"enabled": true,
		"untrimmedFilePath": "<projectFolder>/dist/Lyxal.d.ts"
	},
	"tsdocMetadata": {
		"enabled": false
	},
	"messages": {
		"compilerMessageReporting": {
			"default": {
				"logLevel": "warning"
			}
		},
		"extractorMessageReporting": {
			"default": {
				"logLevel": "warning"
			},
			"ae-missing-release-tag": {
				"logLevel": "none"
			}
		},
		"tsdocMessageReporting": {
			"default": {
				"logLevel": "warning"
			}
		}
	}
}