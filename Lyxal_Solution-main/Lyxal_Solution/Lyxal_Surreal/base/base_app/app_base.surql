-- Configuration de l'application de base
DEFINE TABLE app_base SCHEMAFULL;
DEFINE FIELD app ON app_base TYPE record<app>;
DEFINE FIELD today_date_t ON app_base TYPE datetime;
DEFINE FIELD default_partner_localization ON app_base TYPE record<base_locale>;
DEFINE FIELD email_account_by_user ON app_base TYPE bool DEFAULT false;
DEFINE FIELD email_account_by_company ON app_base TYPE bool DEFAULT false;
DEFINE FIELD store_streets ON app_base TYPE bool DEFAULT false;
DEFINE FIELD qas_wsdl_url ON app_base TYPE string;
DEFINE FIELD draft_prefix ON app_base TYPE string DEFAULT "#";
DEFINE FIELD map_api_select ON app_base TYPE int DEFAULT 2;
DEFINE FIELD google_maps_api_key ON app_base TYPE string;
DEFINE FIELD currency_ws_url ON app_base TYPE string;
DEFINE FIELD fixer_api_key ON app_base TYPE string;
DEFINE FIELD is_fixer_api_paid ON app_base TYPE bool;
DEFINE FIELD currency_conversion_line_list ON app_base TYPE array<record<base_currency_conversion_line>>;
DEFINE FIELD mail_template_association_list ON app_base TYPE array<record<base_mail_template_association>>;
DEFINE FIELD default_mail_message_template ON app_base TYPE option<record<base_template>>;
DEFINE FIELD password_changed_template ON app_base TYPE option<record<base_template>>;
DEFINE FIELD email_link_list ON app_base TYPE array<record<base_model_email_link>>;
DEFINE FIELD unit_days ON app_base TYPE option<record<base_unit>>;
DEFINE FIELD unit_hours ON app_base TYPE option<record<base_unit>>;
DEFINE FIELD unit_minutes ON app_base TYPE option<record<base_unit>>;
DEFINE FIELD barcode_type_config ON app_base TYPE option<record<base_barcode_type_config>>;
DEFINE FIELD pfx_certificate ON app_base TYPE option<record<base_pfx_certificate>>;
DEFINE FIELD product_sequence ON app_base TYPE option<record<base_sequence>>;
DEFINE FIELD default_address_template ON app_base TYPE option<record<base_address_template>>;
DEFINE FIELD client_situation_print_template ON app_base TYPE option<record<base_printing_template>>;
DEFINE FIELD company_phone_book_print_template ON app_base TYPE option<record<base_printing_template>>;
DEFINE FIELD contact_phone_book_print_template ON app_base TYPE option<record<base_printing_template>>;
DEFINE FIELD product_catalog_pgql_print_template ON app_base TYPE option<record<base_printing_template>>;
DEFINE FIELD regroup_products_type_select ON app_base TYPE option<string>;
DEFINE FIELD regroup_products_level_select ON app_base TYPE option<string>;
DEFINE FIELD regroup_products_label_services ON app_base TYPE option<string>;
DEFINE FIELD regroup_products_label_products ON app_base TYPE option<string>;
DEFINE FIELD time_logging_preference_select ON app_base TYPE option<string>;
DEFINE FIELD daily_work_hours ON app_base TYPE option<decimal>;
DEFINE FIELD enable_pricing_scale ON app_base TYPE option<bool>;
DEFINE FIELD is_pricing_computing_order ON app_base TYPE option<bool>;
DEFINE FIELD product_sequence_type_select ON app_base TYPE option<string>;
DEFINE FIELD geo_names_dump_url ON app_base TYPE option<string>;
DEFINE FIELD geo_names_zip_url ON app_base TYPE option<string>;
DEFINE FIELD manage_subsidiary_partner ON app_base TYPE option<bool>;
DEFINE FIELD manage_cc_bcc_related_to ON app_base TYPE option<bool>;
DEFINE FIELD process_timeout ON app_base TYPE option<int>;
DEFINE FIELD shortcut_multi_select ON app_base TYPE option<string>;
DEFINE FIELD has_qas_validation ON app_base TYPE bool;
DEFINE FIELD product_in_ati_select ON app_base TYPE int DEFAULT 1;
DEFINE FIELD nb_decimal_digit_for_unit_price ON app_base TYPE int DEFAULT 2;
DEFINE FIELD nb_decimal_digit_for_qty ON app_base TYPE int DEFAULT 2;
DEFINE FIELD nb_decimal_digit_for_tax_rate ON app_base TYPE int DEFAULT 2;
DEFINE FIELD global_tracking_log_persistence ON app_base TYPE int DEFAULT 1;
DEFINE FIELD is_regroup_products_on_printings ON app_base TYPE bool DEFAULT false;
DEFINE FIELD team_management ON app_base TYPE bool DEFAULT true;
DEFINE FIELD activate_sending_email ON app_base TYPE bool DEFAULT true;
DEFINE FIELD activate_bar_code_generation ON app_base TYPE bool DEFAULT false;
DEFINE FIELD enable_multi_barcode_on_products ON app_base TYPE bool DEFAULT false;
DEFINE FIELD generate_product_sequence ON app_base TYPE bool DEFAULT false;
DEFINE FIELD generate_partner_sequence ON app_base TYPE bool DEFAULT true;
DEFINE FIELD manage_multi_banks ON app_base TYPE bool;
DEFINE FIELD manage_product_variants ON app_base TYPE bool;
DEFINE FIELD enterprise_communication ON app_base TYPE bool DEFAULT true;
DEFINE FIELD document ON app_base TYPE bool DEFAULT true;
DEFINE FIELD enable_trading_names_management ON app_base TYPE bool DEFAULT false;
DEFINE FIELD enable_calendars ON app_base TYPE bool DEFAULT true;
DEFINE FIELD enable_multi_company ON app_base TYPE bool DEFAULT true;
DEFINE FIELD activate_partner_relations ON app_base TYPE bool DEFAULT false;
DEFINE FIELD enable_tax_numbers ON app_base TYPE bool;
DEFINE FIELD created_at ON app_base TYPE datetime DEFAULT time::now();
DEFINE FIELD updated_at ON app_base TYPE datetime DEFAULT time::now();
DEFINE FIELD version ON app_base TYPE int DEFAULT 0;