-- =============================================================================
-- 1. LUCIDE
-- =============================================================================

-- Français
RELATE i18n_key:icon_provider_lucide_name->translation->language:fr
  SET text = 'Lucide';

RELATE i18n_key:icon_provider_lucide_description->translation->language:fr
  SET text = 'Collection moderne d\'icônes stroke open-source. Fork de Feather Icons avec plus de 1400 icônes.';

-- Anglais
RELATE i18n_key:icon_provider_lucide_name->translation->language:en
  SET text = 'Lucide';

RELATE i18n_key:icon_provider_lucide_description->translation->language:en
  SET text = 'Modern open-source stroke icon collection. Fork of Feather Icons with over 1400 icons.';

-- Italien
RELATE i18n_key:icon_provider_lucide_name->translation->language:it
  SET text = 'Lucide';

RELATE i18n_key:icon_provider_lucide_description->translation->language:it
  SET text = 'Collezione moderna di icone stroke open-source. Fork di Feather Icons con oltre 1400 icone.';

-- Allemand
RELATE i18n_key:icon_provider_lucide_name->translation->language:de
  SET text = 'Lucide';

RELATE i18n_key:icon_provider_lucide_description->translation->language:de
  SET text = 'Moderne Open-Source-Strich-Icon-Sammlung. Fork von Feather Icons mit über 1400 Icons.';

-- Espagnol
RELATE i18n_key:icon_provider_lucide_name->translation->language:es
  SET text = 'Lucide';

RELATE i18n_key:icon_provider_lucide_description->translation->language:es
  SET text = 'Colección moderna de iconos stroke de código abierto. Fork de Feather Icons con más de 1400 iconos.';

