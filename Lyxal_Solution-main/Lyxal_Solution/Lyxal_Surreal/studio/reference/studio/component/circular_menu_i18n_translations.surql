-- ============================================================================
-- I18N TRANSLATIONS : studio_component:circular_menu
-- Description : Traductions pour le composant circular_menu
-- Module : studio/i18n
-- ============================================================================

-- Nom du composant - Français
RELATE i18n_key:studio_component_circular_menu_name->translation->language:fr SET
    text = "Menu Circulaire",
    context = "Nom du composant menu circulaire flottant";

-- Nom du composant - Anglais
RELATE i18n_key:studio_component_circular_menu_name->translation->language:en SET
    text = "Circular Menu",
    context = "Name of the floating circular menu component";

-- Nom du composant - Espagnol
RELATE i18n_key:studio_component_circular_menu_name->translation->language:es SET
    text = "Menú Circular",
    context = "Nombre del componente menú circular flotante";

-- Nom du composant - Allemand
RELATE i18n_key:studio_component_circular_menu_name->translation->language:de SET
    text = "Kreismenü",
    context = "Name der schwebenden Kreismenü-Komponente";

-- Nom du composant - Italien
RELATE i18n_key:studio_component_circular_menu_name->translation->language:it SET
    text = "Menu Circolare",
    context = "Nome del componente menu circolare flottante";

-- Description du composant - Français
RELATE i18n_key:studio_component_circular_menu_description->translation->language:fr SET
    text = "Menu circulaire flottant avec expansion radiale pour actions rapides",
    context = "Description du composant menu circulaire avec animation d'expansion";

-- Description du composant - Anglais
RELATE i18n_key:studio_component_circular_menu_description->translation->language:en SET
    text = "Floating circular menu with radial expansion for quick actions",
    context = "Description of the circular menu component with expansion animation";

-- Description du composant - Espagnol
RELATE i18n_key:studio_component_circular_menu_description->translation->language:es SET
    text = "Menú circular flotante con expansión radial para acciones rápidas",
    context = "Descripción del componente menú circular con animación de expansión";

-- Description du composant - Allemand
RELATE i18n_key:studio_component_circular_menu_description->translation->language:de SET
    text = "Schwebendes Kreismenü mit radialer Ausdehnung für schnelle Aktionen",
    context = "Beschreibung der Kreismenü-Komponente mit Ausdehnungsanimation";

-- Description du composant - Italien
RELATE i18n_key:studio_component_circular_menu_description->translation->language:it SET
    text = "Menu circolare flottante con espansione radiale per azioni rapide",
    context = "Descrizione del componente menu circolare con animazione di espansione";
