-- ============================================================================
-- NOM : test_button_name
-- ============================================================================

-- Français
RELATE i18n_key:studio_component_test_button_name->translation->language:fr
    SET text = 'Bouton Test';

-- English
RELATE i18n_key:studio_component_test_button_name->translation->language:en
    SET text = 'Test Button';

-- Italiano
RELATE i18n_key:studio_component_test_button_name->translation->language:it
    SET text = 'Pulsante Test';

-- Deutsch
RELATE i18n_key:studio_component_test_button_name->translation->language:de
    SET text = 'Test-Schaltfläche';

-- Español
RELATE i18n_key:studio_component_test_button_name->translation->language:es
    SET text = 'Botón de Prueba';

-- ============================================================================
-- DESCRIPTION : test_button_description
-- ============================================================================

-- Français
RELATE i18n_key:studio_component_test_button_description->translation->language:fr
    SET text = 'Composant bouton de test pour validation du schéma studio_component';

-- English
RELATE i18n_key:studio_component_test_button_description->translation->language:en
    SET text = 'Test button component for studio_component schema validation';

-- Italiano
RELATE i18n_key:studio_component_test_button_description->translation->language:it
    SET text = 'Componente pulsante di test per la validazione dello schema studio_component';

-- Deutsch
RELATE i18n_key:studio_component_test_button_description->translation->language:de
    SET text = 'Test-Schaltflächenkomponente zur Validierung des studio_component-Schemas';

-- Español
RELATE i18n_key:studio_component_test_button_description->translation->language:es
    SET text = 'Componente de botón de prueba para validación del esquema studio_component';

