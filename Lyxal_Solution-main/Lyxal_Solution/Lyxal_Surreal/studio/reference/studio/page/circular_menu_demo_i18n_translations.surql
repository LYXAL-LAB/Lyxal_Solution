-- Titre de la page - Français
RELATE i18n_key:studio_page_circular_menu_demo_title->translation->language:fr SET
    text = "Démonstration Menu Circulaire - DB Driven",
    context = "Titre de la page de démonstration du menu circulaire";

-- Titre de la page - Anglais
RELATE i18n_key:studio_page_circular_menu_demo_title->translation->language:en SET
    text = "Circular Menu Demo - Database Driven",
    context = "Title of the circular menu demonstration page";

-- Titre de la page - Espagnol
RELATE i18n_key:studio_page_circular_menu_demo_title->translation->language:es SET
    text = "Demo Menú Circular - Base de Datos",
    context = "Título de la página de demostración del menú circular";

-- Titre de la page - Allemand
RELATE i18n_key:studio_page_circular_menu_demo_title->translation->language:de SET
    text = "Kreismenü Demo - Datenbankgesteuert",
    context = "Titel der Kreismenü-Demoseite";

-- Titre de la page - Italien
RELATE i18n_key:studio_page_circular_menu_demo_title->translation->language:it SET
    text = "Demo Menu Circolare - Database Driven",
    context = "Titolo della pagina dimostrazione menu circolare";

-- Description de la page - Français
RELATE i18n_key:studio_page_circular_menu_demo_description->translation->language:fr SET
    text = "Démonstration complète du composant circular_menu entièrement défini en base de données avec différentes configurations",
    context = "Description de la page montrant les capacités DB-driven du menu circulaire";

-- Description de la page - Anglais
RELATE i18n_key:studio_page_circular_menu_demo_description->translation->language:en SET
    text = "Complete demonstration of the circular_menu component fully defined in database with different configurations",
    context = "Description of the page showing the database-driven capabilities of the circular menu";

-- Description de la page - Espagnol
RELATE i18n_key:studio_page_circular_menu_demo_description->translation->language:es SET
    text = "Demostración completa del componente circular_menu completamente definido en base de datos con diferentes configuraciones",
    context = "Descripción de la página que muestra las capacidades de base de datos del menú circular";

-- Description de la page - Allemand
RELATE i18n_key:studio_page_circular_menu_demo_description->translation->language:de SET
    text = "Vollständige Demonstration der in der Datenbank vollständig definierten circular_menu-Komponente mit verschiedenen Konfigurationen",
    context = "Beschreibung der Seite, die die datenbankgesteuerten Fähigkeiten des Kreismenüs zeigt";

-- Description de la page - Italien
RELATE i18n_key:studio_page_circular_menu_demo_description->translation->language:it SET
    text = "Dimostrazione completa del componente circular_menu completamente definito nel database con diverse configurazioni",
    context = "Descrizione della pagina che mostra le capacità database-driven del menu circolare";
