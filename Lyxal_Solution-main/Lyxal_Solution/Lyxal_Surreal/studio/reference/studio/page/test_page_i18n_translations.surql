-- ============================================================================
-- I18N TRANSLATIONS : studio_page:test_page
-- Description : Traductions pour la page de test
-- Module : studio/runtime
-- ============================================================================

-- Titre de la page
RELATE i18n_key:studio_page_test_page_title->translation->language:fr SET text = 'Page de Test';
RELATE i18n_key:studio_page_test_page_title->translation->language:en SET text = 'Test Page';
RELATE i18n_key:studio_page_test_page_title->translation->language:it SET text = 'Pagina di Test';
RELATE i18n_key:studio_page_test_page_title->translation->language:de SET text = 'Testseite';
RELATE i18n_key:studio_page_test_page_title->translation->language:es SET text = 'Página de Prueba';

-- Description de la page
RELATE i18n_key:studio_page_test_page_description->translation->language:fr SET text = 'Page de démonstration du rendu 100% DB-driven. Cette page est entièrement définie dans SurrealDB sans code React.';
RELATE i18n_key:studio_page_test_page_description->translation->language:en SET text = 'Demonstration page for 100% DB-driven rendering. This page is entirely defined in SurrealDB without React code.';
RELATE i18n_key:studio_page_test_page_description->translation->language:it SET text = 'Pagina dimostrativa per il rendering 100% guidato dal database. Questa pagina è interamente definita in SurrealDB senza codice React.';
RELATE i18n_key:studio_page_test_page_description->translation->language:de SET text = 'Demonstrationsseite für 100% datenbankgesteuertes Rendering. Diese Seite ist vollständig in SurrealDB definiert ohne React-Code.';
RELATE i18n_key:studio_page_test_page_description->translation->language:es SET text = 'Página de demostración para renderizado 100% basado en base de datos. Esta página está completamente definida en SurrealDB sin código React.';

