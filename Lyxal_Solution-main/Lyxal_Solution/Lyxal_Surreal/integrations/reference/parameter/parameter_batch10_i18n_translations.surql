CREATE i18n_translation:544686 SET
    i18n_key_id: i18n_key:parameter_hubspotv1_form_getMany_properties_desc,
    language_code: 'fr',
    translated_text: '<p>Used to include specific deal properties in the results. By default, the results will only include Deal ID and will not include the values for any properties for your company.</p><p>Including this parameter will include the data for the specified property in the results. You can include this parameter multiple times to request multiple properties separated by a comma: <code>,</code>.</p>. Choose from the list, or specify IDs using an <a href=',
    is_active: true;

CREATE i18n_translation:544687 SET
    i18n_key_id: i18n_key:parameter_hubspotv1_form_getMany_properties_desc,
    language_code: 'en',
    translated_text: '<p>Used to include specific deal properties in the results. By default, the results will only include Deal ID and will not include the values for any properties for your company.</p><p>Including this parameter will include the data for the specified property in the results. You can include this parameter multiple times to request multiple properties separated by a comma: <code>,</code>.</p>. Choose from the list, or specify IDs using an <a href=',
    is_active: true;

CREATE i18n_translation:544688 SET
    i18n_key_id: i18n_key:parameter_hubspotv1_form_getMany_properties_desc,
    language_code: 'it',
    translated_text: '<p>Used to include specific deal properties in the results. By default, the results will only include Deal ID and will not include the values for any properties for your company.</p><p>Including this parameter will include the data for the specified property in the results. You can include this parameter multiple times to request multiple properties separated by a comma: <code>,</code>.</p>. Choose from the list, or specify IDs using an <a href=',
    is_active: true;

CREATE i18n_translation:544689 SET
    i18n_key_id: i18n_key:parameter_hubspotv1_form_getMany_properties_desc,
    language_code: 'de',
    translated_text: '<p>Used to include specific deal properties in the results. By default, the results will only include Deal ID and will not include the values for any properties for your company.</p><p>Including this parameter will include the data for the specified property in the results. You can include this parameter multiple times to request multiple properties separated by a comma: <code>,</code>.</p>. Choose from the list, or specify IDs using an <a href=',
    is_active: true;

CREATE i18n_translation:544690 SET
    i18n_key_id: i18n_key:parameter_hubspotv1_form_getMany_properties_desc,
    language_code: 'es',
    translated_text: '<p>Used to include specific deal properties in the results. By default, the results will only include Deal ID and will not include the values for any properties for your company.</p><p>Including this parameter will include the data for the specified property in the results. You can include this parameter multiple times to request multiple properties separated by a comma: <code>,</code>.</p>. Choose from the list, or specify IDs using an <a href=',
