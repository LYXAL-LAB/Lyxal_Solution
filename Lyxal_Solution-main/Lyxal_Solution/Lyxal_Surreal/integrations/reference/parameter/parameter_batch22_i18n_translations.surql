CREATE i18n_translation:1304146 SET
    i18n_key_id: i18n_key:parameter_spontit_push_getMany_expirationStamp_desc,
    language_code: 'fr',
    translated_text: 'A Unix timestamp. When to automatically expire your push notification. The default is 10 days after pushing. The push will become unaccessible within 15-30 minutes of the selected time, but will remain on all device screens until dismissed or clicked.',
    is_active: true;

