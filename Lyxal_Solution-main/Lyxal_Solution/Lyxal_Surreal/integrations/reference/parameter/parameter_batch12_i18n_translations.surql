CREATE i18n_translation:717926 SET
    i18n_key_id: i18n_key:parameter_jira_issueAttachment_get_fields_desc,
    language_code: 'fr',
    translated_text: 'A list of fields to return for the issue. This parameter accepts a comma-separated list. Use it to retrieve a subset of fields. Allowed values: <code>*all</code> Returns all fields. <code>*navigable</code> Returns navigable fields. Any issue field, prefixed with a minus to exclude.',
    is_active: true;

