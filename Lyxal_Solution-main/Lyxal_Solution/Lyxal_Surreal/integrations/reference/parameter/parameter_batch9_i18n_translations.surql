    i18n_key_id: i18n_key:parameter_hubspotv1_deal_getMany_properties_desc,
    language_code: 'fr',
    translated_text: '<p>Used to include specific ticket properties in the results. By default, the results will only include ticket ID and will not include the values for any properties for your company.</p><p>Including this parameter will include the data for the specified property in the results. You can include this parameter multiple times to request multiple properties separated by a comma: <code>,</code>.</p>. Choose from the list, or specify IDs using an <a href=',
    is_active: true;

