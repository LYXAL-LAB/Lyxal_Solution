-- Fonction: fn::bunny_pull_zone_public__load_free_certificate
-- Endpoint: GET /pullzone/loadFreeCertificate
-- Description: Load Free Certificate

DEFINE FUNCTION IF NOT EXISTS fn::bunny_pull_zone_public__load_free_certificate(
  $hostname: string
) {

  RETURN function() {

    // Récupérer la clé API
    const apiKey = await surrealdb.value("$bunny_api_key");

    if (!apiKey) {
      return {
        success: false,
        error: 'api_key_missing',
        message: 'Bunny API key is not configured'
      };
    }

    // Construire l'URL
    const hostnameParam = await surrealdb.value("$hostname");
    let url = 'https://api.bunny.net/pullzone/loadFreeCertificate';

    const params = [];
    if (hostnameParam !== null && hostnameParam !== undefined) {
      params.push('hostname=' + encodeURIComponent(hostnameParam));
    }

    if (params.length > 0) {
      url += '?' + params.join('&');
    }

    try {
      // Appel API
      const response = await fetch(url, {
        method: 'GET',
        headers: {
          'Accept': 'application/json',
          'Accesskey': apiKey
        }
      });

      // Logger l'appel API
      await surrealdb.query(`
        CREATE infrastructure_log CONTENT {
          type: 'api_call',
          resource_type: 'Pull Zone',
          bunny_api: {
            endpoint: '/pullzone/loadFreeCertificate',
            method: 'GET',
            status_code: ${response.status}
          },
          status: '${response.ok ? 'success' : 'failed'}',
          timestamp: time::now()
        }
      `);

      // Gestion des erreurs HTTP
      if (!response.ok) {
        const errorData = response.status !== 401 ? await response.json() : null;
        return {
          success: false,
          status: response.status,
          error: errorData?.ErrorKey || 'http_error',
          message: errorData?.Message || `HTTP error! status: ${response.status}`
        };
      }

      const data = await response.json();
      return {
        success: true,
        data: data
      };

    } catch (e) {
      return {
        success: false,
        error: 'exception',
        message: e.message
      };
    }
  };
};