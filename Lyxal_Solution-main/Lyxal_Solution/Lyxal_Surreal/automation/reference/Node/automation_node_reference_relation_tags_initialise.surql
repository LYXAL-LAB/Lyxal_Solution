DEFINE FUNCTION IF NOT EXISTS fn::automation_node_reference_relation_tags_initialise(
    $parent_run_id: option<string>
) {
    -- Paramètres
    LET $parent_run_id = $parent_run_id OR NONE;
    LET $log_extra_tags = ['module_automation'];
    LET $run_id = rand::uuid();

    -- Journalisation: début
    fn::system_log_helper_initialise(
        'data_reference', 'start', 'automation_node_reference_relation_tags',
        { run_id: $run_id, parent_run_id: $parent_run_id },
        $log_extra_tags
    );


    -- ============================================================================================
    -- == Création des relations entre les nodes et les tags
    -- ============================================================================================

    
