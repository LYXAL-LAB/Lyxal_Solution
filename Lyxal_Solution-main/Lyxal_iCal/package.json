{
    "name": "@lyxal/ical",
    "version": "0.1.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "bun build ./src/index.ts --outdir ./dist --target node",
        "build:browser": "bun build ./src/index.ts --outfile ./dist/ical.js --target browser",
        "dev": "bun --watch src/index.ts",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/bun": "^1.3.3",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "chai": "^6.2.1",
        "typescript": "^5.3.0"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "license": "Proprietary"
}