CREATE i18n_key:'i18n.unit.qt.name' SET description = "Nom de l'unité Quarte";

-- Temps
CREATE i18n_key:'i18n.unit.ms.name' SET description = "Nom de l'unité Milliseconde";
CREATE i18n_key:'i18n.unit.s.name' SET description = "Nom de l'unité Seconde";
