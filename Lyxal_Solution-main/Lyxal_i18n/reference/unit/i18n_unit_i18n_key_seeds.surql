-- =============================================================================================
-- |
-- | Fichier     : i18n_unit_i18n_key_seeds.surql
-- | Module      : i18n
-- | Description : Peuple la table `i18n_key` avec les clés pour les noms des unités.
-- |
-- =============================================================================================

-- Poids
CREATE i18n_key:'i18n.unit.mg.name' SET description = "Nom de l'unité Milligramme";
CREATE i18n_key:'i18n.unit.g.name' SET description = "Nom de l'unité Gramme";
CREATE i18n_key:'i18n.unit.kg.name' SET description = "Nom de l'unité Kilogramme";
