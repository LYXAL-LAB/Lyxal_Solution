-- Unité (générique)
CREATE i18n_key:'i18n.unit.unit.name' SET description = "Nom de l'unité 'Unité' (pièce)";

-- Surface
CREATE i18n_key:'i18n.unit.m2.name' SET description = "Nom de l'unité Mètre carré";
