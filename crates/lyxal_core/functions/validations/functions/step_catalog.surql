-- ============================================================================
-- LYXAL OS — CORE VALIDATIONS
-- ============================================================================
-- Fichier  : crates/lyxal_core/functions/validations/functions/step_catalog.surql
-- Fonction : fn::validation_step_catalog
--
-- Catalogue des règles de validation utilisables dans un pipeline du moteur
-- : une règle par validateur à une seule valeur (options = paramètres du
-- validateur ; un paramètre option<…> vaut NONE par défaut, les autres sont
-- obligatoires). fn::validation_object y figure sous le nom is_object,
-- object étant une règle du moteur. Les validateurs qui comparent plusieurs
-- valeurs (compare, date_range, time_range…) s'appellent directement. Aucune
-- règle n'est déclarée idempotente : la réapplication d'un validateur à sa
-- valeur normalisée n'est pas garantie identique.
--
-- Valeur renvoyée : array<object> (contrat : crates/lyxal_core/Readme.md, fonctions validations)
-- ============================================================================
DEFINE FUNCTION OVERWRITE fn::validation_step_catalog() -> array<object> {
    RETURN [
        { rule: "age_range", cost: 1 },
        { rule: "allowed_types", cost: 1, required: ["allowed_types"] },
        { rule: "alphanumeric", cost: 1, required: ["trim_value"] },
        { rule: "ape_naf_code", cost: 1 },
        { rule: "api_key", cost: 1, required: ["min_length", "max_length"] },
        { rule: "archive_entry_path", cost: 1, required: ["max_length"] },
        { rule: "array", cost: 1 },
        { rule: "array_integers", cost: 1 },
        { rule: "array_length", cost: 1 },
        { rule: "array_non_empty", cost: 1 },
        { rule: "array_objects", cost: 1, required: ["allow_empty_objects"] },
        { rule: "array_of_records", cost: 1, required: ["require_exists"] },
        { rule: "array_of_strings", cost: 1, required: ["allow_empty"] },
        { rule: "array_unique", cost: 1 },
        { rule: "array_without_none", cost: 1 },
        { rule: "array_without_null", cost: 1 },
        { rule: "ascii", cost: 1, required: ["trim_value", "allow_blank"] },
        { rule: "base64", cost: 1, required: ["url_safe", "require_padding"] },
        { rule: "bearer_token", cost: 1, required: ["min_length", "max_length"] },
        { rule: "bic", cost: 1 },
        { rule: "birthdate", cost: 1, required: ["allow_today"] },
        { rule: "boolean", cost: 1 },
        { rule: "business_day", cost: 1 },
        { rule: "bytes", cost: 1 },
        { rule: "card_pan", cost: 1 },
        { rule: "certificate_pem", cost: 1, required: ["max_length"] },
        { rule: "checksum", cost: 1, required: ["algorithm"] },
        { rule: "cidr", cost: 1, required: ["allow_ipv4", "allow_ipv6"] },
        { rule: "company_name", cost: 1, required: ["min_length", "max_length"] },
        { rule: "contains", cost: 1, required: ["needles", "case_sensitive", "trim_value"] },
        { rule: "content_disposition_filename", cost: 1, required: ["max_length"] },
        { rule: "content_type", cost: 1 },
        { rule: "contract_version", cost: 1 },
        { rule: "country_code_iso2", cost: 1 },
        { rule: "country_code_iso3", cost: 1 },
        { rule: "cron_expression", cost: 1, required: ["allow_seconds", "allow_macros"] },
        { rule: "currency_code", cost: 1 },
        { rule: "date", cost: 1 },
        { rule: "date_string", cost: 1 },
        { rule: "datetime", cost: 1 },
        { rule: "datetime_string", cost: 1 },
        { rule: "decimal", cost: 1 },
        { rule: "display_name", cost: 1, required: ["min_length", "max_length", "allow_emoji"] },
        { rule: "domain", cost: 1, required: ["allow_subdomains"] },
        { rule: "duration", cost: 1 },
        { rule: "email", cost: 1 },
        { rule: "ends_with", cost: 1, required: ["suffixes", "case_sensitive", "trim_value"] },
        { rule: "enum", cost: 1, required: ["allowed", "case_sensitive"] },
        { rule: "enum_any", cost: 1, required: ["allowed_values"] },
        { rule: "etag", cost: 1, required: ["allow_weak"] },
        { rule: "even", cost: 1 },
        { rule: "execution_priority", cost: 1, required: ["min_priority", "max_priority"] },
        { rule: "execution_timeout", cost: 1, required: ["min_timeout", "max_timeout"] },
        { rule: "exists", cost: 1, required: ["target_table", "target_field"] },
        { rule: "extension", cost: 1, required: ["allow_leading_dot"] },
        { rule: "filename", cost: 1, required: ["min_length", "max_length"] },
        { rule: "filesize", cost: 1 },
        { rule: "first_name", cost: 1, required: ["min_length", "max_length"] },
        { rule: "float", cost: 1 },
        { rule: "forbidden_values", cost: 1, required: ["forbidden_values", "case_sensitive", "trim_value"] },
        { rule: "full_name", cost: 1, required: ["min_words", "max_words", "max_length"] },
        { rule: "future_datetime", cost: 1, required: ["allow_equal"] },
        { rule: "geohash", cost: 1, required: ["min_length", "max_length"] },
        { rule: "gtin", cost: 1 },
        { rule: "geometry", cost: 1, required: ["require_valid"] },
        { rule: "hexadecimal", cost: 1, required: ["allow_prefix"] },
        { rule: "hmac_signature", cost: 1, required: ["encoding"] },
        { rule: "hostname", cost: 1, required: ["allow_single_label"] },
        { rule: "http_method", cost: 1 },
        { rule: "http_url", cost: 1, required: ["allow_http", "allow_https"] },
        { rule: "iban", cost: 1 },
        { rule: "idempotency_key", cost: 1, required: ["min_length", "max_length"] },
        { rule: "identifier", cost: 1, required: ["min_length", "max_length"] },
        { rule: "image_height", cost: 1, required: ["min_height", "max_height"] },
        { rule: "image_width", cost: 1, required: ["min_width", "max_width"] },
        { rule: "initials", cost: 1, required: ["min_count", "max_count"] },
        { rule: "integer", cost: 1 },
        { rule: "invoice_number", cost: 1, required: ["min_length", "max_length"] },
        { rule: "ip", cost: 1 },
        { rule: "iso8601", cost: 1, required: ["allow_fractional_seconds"] },
        { rule: "jwt_compact", cost: 1, required: ["max_length"] },
        { rule: "language_code", cost: 1, required: ["allow_alpha3"] },
        { rule: "last_name", cost: 1, required: ["min_length", "max_length"] },
        { rule: "latitude", cost: 1 },
        { rule: "locale", cost: 1, required: ["require_region"] },
        { rule: "longitude", cost: 1 },
        { rule: "lowercase", cost: 1, required: ["trim_value", "allow_blank"] },
        { rule: "luhn", cost: 1, required: ["min_length", "max_length"] },
        { rule: "lyxal_bucket_name", cost: 1, required: ["min_length", "max_length"] },
        { rule: "lyxal_database", cost: 1, required: ["min_length", "max_length"] },
        { rule: "lyxal_event_name", cost: 1, required: ["min_segments", "max_segments"] },
        { rule: "lyxal_function_name", cost: 1, required: ["require_namespace", "max_length"] },
        { rule: "lyxal_instance_name", cost: 1, required: ["min_length", "max_length"] },
        { rule: "lyxal_module_name", cost: 1, required: ["min_length", "max_length"] },
        { rule: "lyxal_namespace", cost: 1, required: ["min_length", "max_length"] },
        { rule: "lyxal_permission_name", cost: 1 },
        { rule: "lyxal_role_name", cost: 1, required: ["min_length", "max_length"] },
        { rule: "lyxal_storage_path", cost: 1, required: ["allow_file_extension", "max_length"] },
        { rule: "mac_address", cost: 1, required: ["allow_hyphen", "allow_colon"] },
        { rule: "max_length", cost: 1, required: ["max_length"] },
        { rule: "mime_type", cost: 1 },
        { rule: "min_length", cost: 1, required: ["min_length"] },
        { rule: "money", cost: 1, required: ["max_scale"] },
        { rule: "multiple_of", cost: 1, required: ["divisor"] },
        { rule: "negative_number", cost: 1 },
        { rule: "non_negative_number", cost: 1 },
        { rule: "non_zero", cost: 1 },
        { rule: "nonce", cost: 1, required: ["min_length", "max_length"] },
        { rule: "not_blank", cost: 1 },
        { rule: "number", cost: 1 },
        { rule: "is_object", cost: 1 },
        { rule: "object_keys", cost: 1 },
        { rule: "object_no_none", cost: 1 },
        { rule: "object_no_null", cost: 1 },
        { rule: "object_non_empty", cost: 1 },
        { rule: "object_values_type", cost: 1, required: ["expected_type", "allow_empty"] },
        { rule: "odd", cost: 1 },
        { rule: "optional_string", cost: 1 },
        { rule: "origin", cost: 1, required: ["allow_http", "allow_https", "allow_port"] },
        { rule: "password_strength", cost: 1, required: ["min_length", "max_length", "require_uppercase", "require_lowercase", "require_digit", "require_special"] },
        { rule: "past_datetime", cost: 1, required: ["allow_equal"] },
        { rule: "percentage", cost: 1, required: ["min_value", "max_value"] },
        { rule: "phone", cost: 1 },
        { rule: "port", cost: 1, required: ["min_port", "max_port"] },
        { rule: "positive_number", cost: 1 },
        { rule: "postal_code_fr", cost: 1, required: ["allow_cedex"] },
        { rule: "private_key_pem", cost: 1, required: ["allow_encrypted", "max_length"] },
        { rule: "profile_identifier", cost: 1, required: ["min_length", "max_length"] },
        { rule: "public_alias", cost: 1, required: ["min_length", "max_length"] },
        { rule: "public_key_pem", cost: 1, required: ["max_length"] },
        { rule: "queue_name", cost: 1, required: ["min_length", "max_length"] },
        { rule: "record", cost: 1, required: ["expected_table"] },
        { rule: "record_exists", cost: 1 },
        { rule: "record_id", cost: 1 },
        { rule: "recovery_code", cost: 1, required: ["group_count", "group_length"] },
        { rule: "regex", cost: 1, required: ["pattern"] },
        { rule: "required_if", cost: 1, required: ["condition", "allow_null"] },
        { rule: "required_string", cost: 1 },
        { rule: "required_unless", cost: 1, required: ["unless_condition", "allow_null"] },
        { rule: "reserved_words", cost: 1, required: ["reserved_words", "trim_value"] },
        { rule: "retry_policy", cost: 1, required: ["max_attempts_limit", "max_backoff"] },
        { rule: "semantic_version", cost: 1, required: ["allow_v_prefix"] },
        { rule: "siren", cost: 1 },
        { rule: "siret", cost: 1 },
        { rule: "slug", cost: 1 },
        { rule: "snake_case_name", cost: 1, required: ["min_length", "max_length"] },
        { rule: "socket_address", cost: 1, required: ["allow_hostname", "allow_ipv4", "allow_ipv6"] },
        { rule: "starts_with", cost: 1, required: ["prefixes", "case_sensitive", "trim_value"] },
        { rule: "storage_path", cost: 1, required: ["allow_leading_slash", "allow_trailing_slash", "max_length"] },
        { rule: "surql_field", cost: 1, required: ["allow_id", "max_length"] },
        { rule: "surql_field_path", cost: 1, required: ["allow_array_wildcard", "allow_numeric_index", "max_segments"] },
        { rule: "surql_function", cost: 1, required: ["require_namespace", "max_segments"] },
        { rule: "surql_parameter", cost: 1, required: ["allow_reserved"] },
        { rule: "surql_record_string", cost: 1 },
        { rule: "surql_variable", cost: 1, required: ["allow_reserved"] },
        { rule: "time_of_day", cost: 1 },
        { rule: "time_string", cost: 1, required: ["require_seconds"] },
        { rule: "timezone", cost: 1, required: ["allow_utc"] },
        { rule: "totp_code", cost: 1, required: ["digits"] },
        { rule: "totp_secret", cost: 1, required: ["min_length", "max_length"] },
        { rule: "tuple_length", cost: 1, required: ["expected_length"] },
        { rule: "tuple_types", cost: 1, required: ["expected_types"] },
        { rule: "ulid", cost: 1 },
        { rule: "unique", cost: 1, required: ["target_table", "target_field"] },
        { rule: "unknown_keys_policy", cost: 1, required: ["allowed_keys", "policy"] },
        { rule: "uppercase", cost: 1, required: ["trim_value", "allow_blank"] },
        { rule: "uri_scheme", cost: 1 },
        { rule: "url", cost: 1 },
        { rule: "username", cost: 1, required: ["min_length", "max_length", "force_lowercase"] },
        { rule: "uuid", cost: 1 },
        { rule: "uuid_v7", cost: 1, required: ["allow_string"] },
        { rule: "value_type", cost: 1, required: ["expected_type"] },
        { rule: "vat_number_fr", cost: 1, required: ["validate_numeric_key"] },
        { rule: "webhook_path", cost: 1, required: ["allow_parameters", "allow_wildcard"] },
        { rule: "weekday", cost: 1 },
        { rule: "workflow_delay", cost: 1, required: ["min_delay", "max_delay", "allow_zero"] }
    ];
}
COMMENT "Catalogue des règles de validation utilisables dans un pipeline du moteur : une règle par validateur à une seule valeur (options = paramètres du validateur ; un paramètre option<…> vaut NONE par défaut, les autres sont obligatoires). fn::validation_object y figure sous le nom is_object, object étant une règle du moteur. Les validateurs qui comparent plusieurs valeurs (compare, date_range, time_range…) s'appellent directement. Aucune règle n'est déclarée idempotente : la réapplication d'un validateur à sa valeur normalisée n'est pas garantie identique."
PERMISSIONS FULL;
