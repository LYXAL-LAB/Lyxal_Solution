-- ============================================================================
-- LYXAL OS — TESTS CORE VALIDATION
-- ============================================================================
-- Fichier      : core/validation/tests/iso8601.test.surql
-- Fonction     : fn::validation_iso8601
-- Domaine      : Core / Validation
-- Version      : 1.0.0
--
-- Important
-- ---------
-- Les tests provoquant volontairement un THROW doivent être exécutés
-- individuellement dans Surrealist.
-- ============================================================================


-- ============================================================================
-- TEST 1 — UTC valide
-- Résultat attendu : "2026-08-03T10:00:00Z"
-- ============================================================================
RETURN fn::validation_iso8601(
    "2026-08-03T10:00:00Z", "DATETIME", true
);

-- ============================================================================
-- TEST 2 — Décalage valide
-- Résultat attendu : "2026-08-03T12:00:00+02:00"
-- ============================================================================
RETURN fn::validation_iso8601(
    "2026-08-03T12:00:00+02:00", "DATETIME", true
);

-- ============================================================================
-- TEST 3 — Fraction valide
-- Résultat attendu : "2026-08-03T10:00:00.123Z"
-- ============================================================================
RETURN fn::validation_iso8601(
    "2026-08-03T10:00:00.123Z", "DATETIME", true
);

-- ============================================================================
-- TEST 4 — Fraction interdite
-- Erreur attendue : DATETIME_INVALID_ISO8601
-- ============================================================================
RETURN fn::validation_iso8601(
    "2026-08-03T10:00:00.123Z", "DATETIME", false
);

-- ============================================================================
-- TEST 5 — Fuseau absent
-- Erreur attendue : DATETIME_INVALID_ISO8601
-- ============================================================================
RETURN fn::validation_iso8601(
    "2026-08-03T10:00:00", "DATETIME", true
);
